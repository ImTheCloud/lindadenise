---
// Musique de forêt calme, en boucle : coupée par défaut, le visiteur l'active ou la coupe (bouton rond en bas à gauche).
// Le fichier (public/audio/foret.m4a, fait par scripts/foret.py) n'est chargé qu'après un clic, ou si le visiteur l'avait déjà mise.
// Le choix est gardé sur l'appareil (localStorage). Chaque page est un nouveau chargement : la position de la musique est notée
// (sessionStorage, avec l'heure) et la page suivante reprend au bon endroit, comme si elle n'avait pas été interrompue.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).musique;
---
<button class="musique" type="button" aria-pressed="false" aria-label={m.activer} title={m.activer} data-musique data-activer={m.activer} data-couper={m.couper} hidden>
  <svg viewBox="0 0 48 48" width="28" height="28" aria-hidden="true">
    <g class="musique__note" fill="currentColor"><path d="M20 10 L34 7 V30 a6 5 0 1 1 -4 -4.7 V14 L24 15.2 V34 a6 5 0 1 1 -4 -4.7 Z" /></g>
    <path class="musique__barre" d="M8 40 L40 8" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none" />
  </svg>
</button>
<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-musique]');
  if (bouton && 'Audio' in window) {
    bouton.hidden = false;
    const lire = (k: string, ou: Storage) => { try { return ou.getItem(k); } catch { return null; } };
    const ecrire = (k: string, v: string, ou: Storage) => { try { ou.setItem(k, v); } catch { /* sans stockage : le choix ne dure que sur cette page */ } };
    let audio: HTMLAudioElement | null = null;
    let voulue = lire('musique', localStorage) === '1';
    let fondu = 0;

    const montrer = () => {
      const texte = voulue ? bouton.dataset.couper! : bouton.dataset.activer!;
      bouton.setAttribute('aria-pressed', String(voulue));
      bouton.setAttribute('aria-label', texte);
      bouton.title = texte;
    };
    const VOLUME = 0.45;
    const volume = (cible: number, fin?: () => void) => {
      window.clearInterval(fondu);
      fondu = window.setInterval(() => {
        if (!audio) return;
        const v = audio.volume + Math.sign(cible - audio.volume) * 0.05;
        audio.volume = Math.abs(cible - v) < 0.05 ? cible : Math.min(1, Math.max(0, v));
        if (audio.volume === cible) { window.clearInterval(fondu); fin?.(); }
      }, 60);
    };
    const noter = () => { if (audio && voulue && !audio.paused) ecrire('musique-t', JSON.stringify({ t: audio.currentTime, at: Date.now() }), sessionStorage); };
    const jouer = () => {
      if (!audio) {
        audio = new Audio('/audio/foret.m4a');
        audio.loop = true;
        // reprise : la position notée sur la page précédente, avancée du temps passé depuis (la musique n'a pas cessé de « tourner »)
        let note: { t: number; at: number } | null = null;
        try { note = JSON.parse(lire('musique-t', sessionStorage) ?? 'null'); } catch { note = null; }
        const reprise = note && Date.now() - note.at < 60000 ? note : null;
        audio.volume = reprise ? VOLUME : 0;
        if (reprise) audio.addEventListener('loadedmetadata', () => { if (audio) audio.currentTime = (reprise.t + (Date.now() - reprise.at) / 1000) % audio.duration; }, { once: true });
        audio.addEventListener('timeupdate', noter);
      }
      audio.play().then(() => volume(VOLUME)).catch(() => {
        // pas encore de geste du visiteur sur cette page : on attend son premier toucher
        const premier = () => { if (voulue) jouer(); };
        document.addEventListener('pointerdown', premier, { once: true });
        document.addEventListener('keydown', premier, { once: true });
      });
    };
    const arreter = () => volume(0, () => audio?.pause());

    bouton.addEventListener('click', () => {
      voulue = !voulue;
      ecrire('musique', voulue ? '1' : '0', localStorage);
      montrer();
      if (voulue) jouer(); else arreter();
    });
    // onglet caché : silence ; de retour : elle reprend
    document.addEventListener('visibilitychange', () => {
      if (!audio) return;
      if (document.hidden) audio.pause(); else if (voulue) audio.play().catch(() => {});
    });
    window.addEventListener('pagehide', noter);
    montrer();
    if (voulue) jouer();
  }
</script>
<style>
  .musique { position: fixed; left: 14px; bottom: 14px; z-index: 40; width: 48px; height: 48px; display: grid; place-items: center; padding: 0; cursor: pointer; color: var(--vert-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 50%; box-shadow: var(--ombre); }
  .musique[hidden] { display: none; }
  .musique:hover { transform: translateY(-1px); }
  .musique[aria-pressed='true'] { background: var(--vert-fonce); color: #fff; }
  .musique[aria-pressed='true'] .musique__barre { display: none; }
  /* la barre de sélection de la page Toiles occupe le bas de l'écran : le bouton monte au-dessus */
  :global(body:has([data-selection]:not([hidden]))) .musique { bottom: 118px; }
  @media (prefers-reduced-motion: reduce) { .musique:hover { transform: none; } }
</style>
