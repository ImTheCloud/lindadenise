---
import svg from './noisette.svg?raw';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const n = t(lang).noisette;
const donnees = JSON.stringify({ sections: n.sections, anecdotes: n.anecdotes });
---
<aside class="noisette" data-etat="repos" data-donnees={donnees} aria-label={n.nom}>
  <div class="noisette__bulle" role="status" aria-live="polite" hidden>
    <p class="noisette__texte"></p>
    <button class="noisette__muet" type="button" aria-label={n.fermer}>×</button>
  </div>
  <button class="noisette__corps" type="button" aria-label={n.parler}>
    <Fragment set:html={svg} />
  </button>
</aside>

<script>
  const racine = document.querySelector<HTMLElement>('.noisette');
  if (racine) {
    const bulle = racine.querySelector<HTMLElement>('.noisette__bulle')!;
    const texte = racine.querySelector<HTMLElement>('.noisette__texte')!;
    const corps = racine.querySelector<HTMLButtonElement>('.noisette__corps')!;
    const fermer = racine.querySelector<HTMLButtonElement>('.noisette__muet')!;
    const { sections, anecdotes } = JSON.parse(racine.dataset.donnees ?? '{}') as {
      sections: Record<string, string>;
      anecdotes: string[];
    };

    const lire = (cle: string) => { try { return sessionStorage.getItem(cle); } catch { return null; } };
    const ecrire = (cle: string, v: string) => { try { sessionStorage.setItem(cle, v); } catch { /* sans stockage */ } };

    let muet = lire('noisette-muet') === '1';
    let dernierSujet = '';
    let dernierChangement = 0;
    let minuteurBulle: number | undefined;
    let minuteurEtat: number | undefined;
    let rang = 0;

    const etat = (e: string, duree = 0) => {
      racine.dataset.etat = e;
      window.clearTimeout(minuteurEtat);
      if (duree) minuteurEtat = window.setTimeout(() => (racine.dataset.etat = 'repos'), duree);
    };

    const dire = (message: string, duree = 9000) => {
      if (muet || !message) return;
      texte.textContent = message;
      bulle.hidden = false;
      bulle.classList.remove('pop');
      void bulle.offsetWidth;
      bulle.classList.add('pop');
      etat('parle', Math.min(duree - 500, 600 + message.length * 55));
      window.clearTimeout(minuteurBulle);
      minuteurBulle = window.setTimeout(() => (bulle.hidden = true), duree);
      dernierChangement = Date.now();
    };

    fermer.addEventListener('click', () => {
      muet = true;
      ecrire('noisette-muet', '1');
      bulle.hidden = true;
      etat('repos');
    });

    corps.addEventListener('click', () => {
      if (muet) { muet = false; ecrire('noisette-muet', '0'); }
      etat('saute', 900);
      window.setTimeout(() => dire(anecdotes[rang++ % anecdotes.length], 8000), 450);
    });
    racine.addEventListener('mouseenter', () => window.clearTimeout(minuteurBulle));
    racine.addEventListener('mouseleave', () => {
      if (!bulle.hidden) minuteurBulle = window.setTimeout(() => (bulle.hidden = true), 3500);
    });

    // Accueil : salut de bienvenue une seule fois par visite
    const depart = document.body.dataset.noisetteDepart ?? 'texte';
    const dejaVu = lire('noisette-vu') === '1';
    dernierSujet = depart;
    if (!dejaVu) {
      window.setTimeout(() => {
        etat('salut', 3200);
        ecrire('noisette-vu', '1');
        dire(sections[depart]);
      }, 1000);
    }
    // Pendant la saisie d'un message, elle se tait
    document.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea, select')) bulle.hidden = true;
    });

    // Elle commente la section visible
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (!e.isIntersecting) continue;
            const cle = (e.target as HTMLElement).dataset.noisette ?? '';
            if (!cle || cle === dernierSujet || !sections[cle]) continue;
            if (Date.now() - dernierChangement < 4000) continue;
            dernierSujet = cle;
            dire(sections[cle]);
          }
        },
        { threshold: 0.55 },
      );
      document.querySelectorAll('[data-noisette]').forEach((el) => obs.observe(el));
    }
  }
</script>

<style is:global>
  .noisette { position: fixed; right: clamp(8px, 2vw, 28px); bottom: 0; z-index: 60; width: clamp(104px, 17vw, 300px); pointer-events: none; }
  .noisette > * { pointer-events: auto; }
  .noisette__corps { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; filter: drop-shadow(0 6px 8px rgba(43, 110, 58, 0.18)); }
  .noisette__corps:focus-visible { outline-offset: 0; }
  .noisette-svg { width: 100%; height: auto; overflow: visible; }

  .noisette__bulle { position: absolute; right: 8%; bottom: calc(100% - 6px); width: max-content; max-width: min(300px, calc(100vw - 32px)); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 22px 12px 20px 12px / 12px 20px 12px 22px; padding: 12px 44px 12px 16px; font-size: 1.02rem; line-height: 1.35; box-shadow: 0 5px 0 rgba(43, 110, 58, 0.15); transform-origin: 85% 100%; }
  .noisette__bulle[hidden] { display: none; }
  .noisette__bulle::after { content: ''; position: absolute; right: 30px; bottom: -14px; width: 18px; height: 18px; background: #fff; border-right: var(--trait) solid var(--vert-fonce); border-bottom: var(--trait) solid var(--vert-fonce); transform: rotate(45deg) skew(8deg, 8deg); }
  .noisette__bulle.pop { animation: noisette-pop 0.45s cubic-bezier(0.3, 1.5, 0.5, 1); }
  .noisette__texte { margin: 0; color: var(--encre); }
  .noisette__muet { position: absolute; top: 0; right: 0; width: 44px; height: 44px; border: 0; background: none; font-size: 1.6rem; line-height: 1; color: var(--vert-fonce); cursor: pointer; border-radius: 50%; }
  .noisette__muet:hover { background: var(--orange-creme); color: var(--orange-fonce); }

  /* Les parties de l'écureuil bougent chacune de leur côté */
  /* Points de pivot en unités du dessin (viewBox 340 x 320), pas en pourcentages */
  .n-queue { transform-origin: 214px 262px; animation: n-queue 5s ease-in-out infinite; }
  .n-tete { transform-origin: 128px 140px; animation: n-tete 6s ease-in-out infinite; }
  .n-corps { transform-origin: 150px 290px; animation: n-respire 3.6s ease-in-out infinite; }
  .n-paupiere { transform-origin: 86px 86px; transform: scaleY(0); animation: n-cligne 5.5s infinite; }
  .n-bras { transform-origin: 140px 166px; }
  .n-oreille { transform-origin: 122px 76px; }
  .noisette__corps:hover .n-oreille { animation: n-oreille 0.5s ease-in-out 2; }
  .noisette-svg .n-bouche-ouverte { display: none !important; }

  .noisette[data-etat='parle'] .n-bouche-fermee { display: none; }
  .noisette[data-etat='parle'] .n-bouche-ouverte { display: block !important; transform-origin: 74px 122px; animation: n-parle 0.34s ease-in-out infinite; }
  .noisette[data-etat='parle'] .n-tete { animation: n-hoche 0.7s ease-in-out infinite; }

  .noisette[data-etat='salut'] .n-gland { opacity: 0; }
  .noisette[data-etat='salut'] .n-bras { animation: n-salue 0.55s ease-in-out infinite alternate; }
  .noisette[data-etat='salut'] .n-bouche-fermee { display: none; }
  .noisette[data-etat='salut'] .n-bouche-ouverte { display: block !important; }

  .noisette[data-etat='saute'] .noisette__corps { animation: n-saute 0.8s cubic-bezier(0.3, 0.7, 0.4, 1); }

  @keyframes noisette-pop { from { transform: scale(0.6) rotate(-3deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes n-queue { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(3.5deg); } }
  @keyframes n-tete { 0%, 100% { transform: rotate(-1.5deg); } 50% { transform: rotate(2deg); } }
  @keyframes n-hoche { 0%, 100% { transform: rotate(-3deg) translateY(0); } 50% { transform: rotate(3deg) translateY(2px); } }
  @keyframes n-respire { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.014); } }
  @keyframes n-cligne { 0%, 92%, 100% { transform: scaleY(0); } 95% { transform: scaleY(1); } }
  @keyframes n-parle { 0%, 100% { transform: scaleY(0.45); } 50% { transform: scaleY(1); } }
  @keyframes n-salue { from { transform: rotate(62deg); } to { transform: rotate(98deg); } }
  @keyframes n-saute { 0% { transform: translateY(0) scale(1, 1); } 15% { transform: translateY(0) scale(1.06, 0.92); } 45% { transform: translateY(-34px) scale(0.96, 1.06); } 80% { transform: translateY(0) scale(1.05, 0.94); } 100% { transform: none; } }
  @keyframes n-oreille { 50% { transform: rotate(-12deg); } }

  @media (max-width: 700px) {
    .noisette { width: 104px; right: 4px; }
    .noisette__bulle { right: 2px; font-size: 0.98rem; max-width: min(240px, calc(100vw - 20px)); }
  }
</style>
