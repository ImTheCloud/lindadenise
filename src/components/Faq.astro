---
// Questions fréquentes : une question par ligne, la réponse s'ouvre au toucher (aucun script).
interface Props { titre: string; questions: { q: string; r: string }[]; titreNiveau?: 1 | 2 }
const { titre, questions, titreNiveau = 2 } = Astro.props;
const Titre = `h${titreNiveau}` as 'h1' | 'h2';
---
<section class="section faq">
  <div class="contenu faq__corps">
    <Titre class="centre">{titre}</Titre>
    <div class="faq__liste">
      {questions.map((x) => (
        <details class="faq__item">
          <summary>{x.q}</summary>
          <p>{x.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq__corps { max-width: 820px; }
  .faq :global(h1), .faq :global(h2) { margin-bottom: 14px; }
  .faq__liste { display: grid; gap: 8px; }
  .faq__item { background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); box-shadow: var(--ombre); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 6px 16px; font-family: var(--titre); font-size: 1.25rem; line-height: 1.2; color: var(--vert-fonce); cursor: pointer; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 30px; height: 30px; font-size: 1.5rem; line-height: 1; color: #fff; background: var(--vert-fonce); border-radius: 50%; }
  .faq__item[open] summary::after { content: '–'; }
  @media (max-width: 519px) { .faq__item summary { font-size: 1.1rem; padding: 6px 12px; } }
  .faq__item summary:hover { color: var(--orange-fonce); }
  .faq__item p { margin: 0; padding: 0 16px 12px; color: var(--encre-douce); }
</style>
