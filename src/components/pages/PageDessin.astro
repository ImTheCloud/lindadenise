---
import Base from '../../layouts/Base.astro';
import CarteDessin from '../CarteDessin.astro';
import Apercu from '../Apercu.astro';
import Etapes from '../Etapes.astro';
import { t, chemin, cheminDessin, dessins, parRubrique, type Dessin, type Lang } from '../../i18n';
interface Props { lang: Lang; dessin: Dessin }
const { lang, dessin } = Astro.props;
const d = t(lang);
const titre = dessin.titre[lang];
const chemins = { fr: cheminDessin(dessin.id, 'fr'), nl: cheminDessin(dessin.id, 'nl') };
const i = dessins.findIndex((x) => x.id === dessin.id);
const prec = dessins[(i - 1 + dessins.length) % dessins.length];
const suiv = dessins[(i + 1) % dessins.length];
// Dessins à voir aussi : ceux de la même rubrique qui suivent celui-ci (donc différents d'une fiche à l'autre), complétés par la suite du catalogue.
const apres = [...dessins.slice(i + 1), ...dessins.slice(0, i)];
const memeRubrique = [...apres.filter((x) => x.rubrique === dessin.rubrique), ...apres.filter((x) => x.rubrique !== dessin.rubrique)].slice(0, 4);
const rub = d.rubriques[dessin.rubrique];
const contactUrl = `${chemin('contact', lang)}?dessin=${dessin.id}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: titre,
  creator: { '@type': 'Person', name: 'Linda Denise' },
  artform: 'Digital drawing',
  image: `https://lindadenise.be/dessins/${dessin.id}.webp`,
};
---
<Base lang={lang} titre={titre} description={`${d.dessins.altDe(titre)} · ${rub.court} · ${d.dessins.prix}`} chemins={chemins} image={`/dessins/${dessin.id}.webp`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <section class="section section--fiche">
    <div class="contenu">
      <p><a href={chemin('dessins', lang)}>{d.dessins.retour}</a></p>
      <div class="fiche">
        <div class="fiche__image cadre">
          <button type="button" class="fiche__zoom" data-zoom aria-label={d.dessins.agrandir}>
            <Apercu id={dessin.id} grand alt={d.dessins.altDe(titre)} largeur={dessin.largeur} hauteur={dessin.hauteur} chargement="eager" priorite />
          </button>
        </div>
        <div class="fiche__infos">
          <p class="surtitre">{d.dessins.rubrique} · <a href={`${chemin('dessins', lang)}#${dessin.rubrique}`}>{rub.court}</a></p>
          <h1>{titre}</h1>
          <p class="fiche__prix">{d.dessins.prix}</p>
          <p>{d.dessins.prixTexte}</p>
          <p><a class="bouton" href={contactUrl}>{d.dessins.cta}</a></p>
          <p class="fiche__petit"><a href={chemin('licence', lang)}>{d.dessins.licence}</a></p>
          <nav class="fiche__nav" aria-label="Navigation">
            <a href={cheminDessin(prec.id, lang)} rel="prev">
              <Apercu id={prec.id} alt="" largeur={prec.largeur} hauteur={prec.hauteur} />
              <span>← {d.dessins.precedent}</span>
            </a>
            <a href={cheminDessin(suiv.id, lang)} rel="next">
              <Apercu id={suiv.id} alt="" largeur={suiv.largeur} hauteur={suiv.hauteur} />
              <span>{d.dessins.suivant} →</span>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--orange">
    <div class="contenu"><Etapes titre={d.dessins.etapesTitre} etapes={d.dessins.etapes} /></div>
  </section>
  <section class="section section--vert">
    <div class="contenu">
      <h2 class="centre">{d.dessins.autres}</h2>
      <div class="suite">
        {memeRubrique.map((x) => <CarteDessin dessin={x} lang={lang} />)}
      </div>
    </div>
  </section>
  <dialog class="zoom" id="zoom" aria-label={titre}>
    <button type="button" class="zoom__fermer" data-fermer aria-label={d.dessins.fermer}>×</button>
    <img src={`/dessins/${dessin.id}.webp`} alt={d.dessins.altDe(titre)} width={dessin.largeur} height={dessin.hauteur} />
  </dialog>
</Base>

<script>
  const zoom = document.querySelector<HTMLDialogElement>('#zoom');
  document.querySelector('[data-zoom]')?.addEventListener('click', () => zoom?.showModal());
  zoom?.addEventListener('click', () => zoom.close());
</script>

<style>
  .fiche__zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .zoom { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100svh; width: 100%; height: 100%; overflow: hidden; }
  .zoom::backdrop { background: rgba(20, 30, 22, 0.88); }
  .zoom[open] { display: grid; place-items: center; cursor: zoom-out; }
  .zoom img { width: auto; height: auto; max-width: 96vw; max-height: 94svh; border-radius: 10px; background: #fff; }
  .zoom__fermer { position: absolute; top: 12px; right: 14px; width: 48px; height: 48px; border-radius: 50%; border: 0; background: #fff; color: var(--vert-fonce); font-size: 2rem; line-height: 1; cursor: pointer; }
  .fiche { display: grid; gap: 18px; align-items: start; }
  .fiche__image { padding: 12px; max-width: 560px; margin-inline: auto; }
  .fiche__image :global(img) { width: auto; max-width: 100%; height: auto; max-height: calc(100svh - 150px); margin-inline: auto; border-radius: 12px 6px 12px 8px / 8px 12px 6px 12px; }
  .fiche__prix { font-family: var(--titre); font-size: 2.6rem; color: var(--orange-fonce); margin: 0 0 4px; line-height: 1.1; }
  .fiche__petit { font-size: 0.98rem; }
  .fiche__nav { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-top: 34px; padding-top: 18px; border-top: 3px dashed var(--vert-pale); font-family: var(--titre); font-size: 1.3rem; }
  .fiche__nav a { display: grid; gap: 6px; text-decoration: none; justify-items: start; }
  .fiche__nav a[rel='next'] { justify-items: end; text-align: right; }
  .fiche__nav :global(img) { height: 84px; width: auto; border-radius: 8px 4px 8px 5px / 5px 8px 4px 8px; border: 2px solid var(--vert-fonce); }
  .suite { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 28px; }
  .suite :global(.carte) { margin: 0; }
  /* Mobile : le dessin, son titre, son prix et le bouton tiennent dans un seul écran. */
  @media (max-width: 859px) {
    .section--fiche { padding-top: 14px; }
    .section--fiche > .contenu > p { margin: 0 0 8px; }
    .fiche__image { padding: 8px; }
    .fiche__image :global(img) { max-height: max(240px, calc(100svh - 300px)); }
    .fiche__infos { display: grid; grid-template-columns: auto auto 1fr; align-items: center; column-gap: 16px; }
    .fiche__infos > :nth-child(1), .fiche__infos > :nth-child(2), .fiche__infos > :nth-child(4), .fiche__infos > :nth-child(6), .fiche__infos > :nth-child(7) { grid-column: 1 / -1; }
    .fiche__infos > :nth-child(3) { grid-column: 2; grid-row: 3; }
    .fiche__infos > :nth-child(5) { grid-column: 1; grid-row: 3; }
    .fiche__infos h1 { font-size: 1.9rem; margin: 0 0 4px; }
    .fiche__infos p { margin: 0 0 6px; }
    .fiche__infos .surtitre { margin: 0 0 0; }
    .fiche__prix { font-size: 2.2rem; margin: 0; }
    .fiche__infos .bouton { padding: 10px 18px; font-size: 1.15rem; }
    .fiche__nav { margin-top: 18px; }
  }
  @media (min-width: 860px) {
    .fiche { grid-template-columns: 1.05fr 0.95fr; gap: 64px; }
    .fiche__image { position: sticky; top: 92px; margin: 0; }
    .suite { grid-template-columns: repeat(4, 1fr); }
  }
</style>
