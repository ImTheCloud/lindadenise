---
import IconeLivraison from '../IconeLivraison.astro';
import Base from '../../layouts/Base.astro';
import { t, chemin, cheminDessin, cheminToile, dessins, toiles, type Lang } from '../../i18n';
import { PRIX_DESSIN, PRIX_TOILE } from '../../data/vente';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const p = d.panier;
const chemins = { fr: chemin('panier', 'fr'), nl: chemin('panier', 'nl') };
// Tout ce que le script de la page affiche vient d'ici : les textes restent dans les dictionnaires.
const donnees = {
  dessins: Object.fromEntries(dessins.map((x) => [x.id, { titre: x.titre[lang], href: cheminDessin(x.id, lang), img: `/dessins/${x.id}-vignette.webp` }])),
  toiles: Object.fromEntries(toiles.map((x) => [x.id, { titre: x.titre[lang], href: cheminToile(x.id, lang), img: `/toiles/${x.id}-400.webp`, vendue: x.vendue }])),
  prix: { dessin: PRIX_DESSIN, toile: PRIX_TOILE },
  textes: p,
  contact: `${chemin('contact', lang)}?sujet=commande`,
};
---
<Base lang={lang} titre={p.titre} description={p.meta} chemins={chemins} noindex>
  <section class="section">
    <div class="contenu panier" data-panier-page data-donnees={JSON.stringify(donnees)}>
      <header class="centre">
        <h1>{p.titre}</h1>
        <p class="chapeau">{p.intro}</p>
      </header>

      <div class="panier__vide cadre centre" data-vide hidden>
        <p>{p.vide}</p>
        <p class="panier__liens">
          <a class="bouton bouton--vert" href={chemin('dessins', lang)}>{p.videDessins}</a>
          <a class="bouton bouton--contour" href={chemin('toiles', lang)}>{p.videToiles}</a>
        </p>
      </div>

      <div class="panier__carte" data-contenu hidden>
        <section class="groupe" data-groupe-dessins hidden>
          <header class="groupe__tete">
            <span class="groupe__icone"><IconeLivraison genre="dessin" taille={18} /></span>
            <h2>{p.titreDessins}</h2>
            <p>{p.livraisonDessin}</p>
          </header>
          <ul class="panier__liste" data-liste-dessins></ul>
        </section>
        <section class="groupe" data-monde="toiles" data-groupe-toiles hidden>
          <header class="groupe__tete">
            <span class="groupe__icone"><IconeLivraison genre="toile" taille={18} /></span>
            <h2>{p.titreToiles}</h2>
            <p>{p.livraisonToile}</p>
          </header>
          <ul class="panier__liste" data-liste-toiles></ul>
        </section>
        <div class="panier__recap">
          <dl class="recap__lignes" data-lignes></dl>
          <p class="panier__note" data-note-dessins>{p.note}</p>
          <p class="panier__note" data-note-toiles hidden>{p.noteToile}</p>
          <p class="panier__note" data-delai hidden>{p.delaiCommande}</p>
          <p class="panier__actions">
            <a class="bouton bouton--vert" data-demander href={`${chemin('contact', lang)}?sujet=commande`}>{p.demander}</a>
            <button type="button" class="panier__vider" data-vider>{p.vider}</button>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
<script>
  import { lire, garder, vider } from '../panier';
  import { calculPanier } from '../../data/vente';
  interface Donnees {
    dessins: Record<string, { titre: string; href: string; img: string }>;
    toiles: Record<string, { titre: string; href: string; img: string; vendue: boolean }>;
    prix: { dessin: number; toile: number };
    textes: {
      genres: { dessin: string; toile: string; commande: string };
      retirer: string;
      lignes: { dessins: string; toiles: string; lotUne: string; lotPlusieurs: string; lotDessinUn: string; lotDessinsPlusieurs: string; envoi: string; envoiPlusieurs: string; envoiOffert: string; total: string };
    };
  }
  const racine = document.querySelector<HTMLElement>('[data-panier-page]');
  if (racine) {
    const d = JSON.parse(racine.dataset.donnees ?? '{}') as Donnees;
    const el = <T extends Element>(s: string) => racine.querySelector<T>(s)!;
    const vide = el<HTMLElement>('[data-vide]'), contenu = el<HTMLElement>('[data-contenu]'), listeDessins = el<HTMLElement>('[data-liste-dessins]'), listeToiles = el<HTMLElement>('[data-liste-toiles]');
    const groupeDessins = el<HTMLElement>('[data-groupe-dessins]'), groupeToiles = el<HTMLElement>('[data-groupe-toiles]');
    const noteDessins = el<HTMLElement>('[data-note-dessins]'), noteToiles = el<HTMLElement>('[data-note-toiles]');
    const lignes = el<HTMLElement>('[data-lignes]'), delai = el<HTMLElement>('[data-delai]');
    const euros = (n: number) => `${n} €`;
    const noeud = <K extends keyof HTMLElementTagNameMap>(nom: K, classe: string, texte = '') => {
      const n = document.createElement(nom);
      n.className = classe;
      if (texte) n.textContent = texte;
      return n;
    };

    function article(genre: 'dessin' | 'toile' | 'commande', id: string) {
      const src = genre === 'toile' ? d.toiles[id] : d.dessins[id];
      const li = noeud('li', `article article--${genre}`);
      // toute la ligne (vignette, titre, prix) ouvre la page de l'article, avec ses autres options
      const lien = noeud('a', 'article__lien');
      lien.href = src.href;
      const img = noeud('img', 'article__img');
      img.src = src.img; img.alt = ''; img.width = 56; img.loading = 'lazy';
      const corps = noeud('div', 'article__corps');
      const titre = noeud('span', 'article__titre', src.titre);
      const prix = genre === 'dessin' ? d.prix.dessin : d.prix.toile;
      // le bloc dit déjà « dessins » ou « toiles » : on ne précise que la toile sur commande
      if (genre === 'commande') corps.append(noeud('span', 'article__genre', d.textes.genres.commande));
      corps.append(titre, noeud('span', 'article__prix', euros(prix)));
      lien.append(img, corps);
      // retirer : une petite croix (le texte reste pour les lecteurs d'écran)
      const retirer = noeud('button', 'article__retirer');
      retirer.type = 'button';
      retirer.dataset.panier = `${genre}:${id}`;
      retirer.dataset.ajouter = d.textes.retirer;
      retirer.dataset.dedans = d.textes.retirer;
      retirer.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg><span class="sr-only" data-panier-texte></span>';
      li.append(lien, retirer);
      return li;
    }

    function ligne(nom: string, valeur: string, monde?: string, fort = false) {
      const ligneEl = noeud('div', fort ? 'ligne ligne--total' : 'ligne');
      if (monde) ligneEl.dataset.m = monde;
      ligneEl.append(noeud('dt', '', nom), noeud('dd', '', valeur));
      return ligneEl;
    }

    function rendre() {
      // les articles qui n'existent plus (toile vendue depuis, dessin retiré) sortent du panier
      const p = garder({
        dessin: new Set(Object.keys(d.dessins)),
        toile: new Set(Object.keys(d.toiles).filter((id) => !d.toiles[id].vendue)),
        commande: new Set(Object.keys(d.dessins)),
      });
      const nombreToiles = p.toile.length + p.commande.length;
      const total = p.dessin.length + nombreToiles;
      vide.hidden = total > 0;
      contenu.hidden = total === 0;
      listeDessins.replaceChildren(...p.dessin.map((id) => article('dessin', id)));
      listeToiles.replaceChildren(...p.toile.map((id) => article('toile', id)), ...p.commande.map((id) => article('commande', id)));
      groupeDessins.hidden = p.dessin.length === 0;
      groupeToiles.hidden = nombreToiles === 0;
      // la note de paiement ne parle de livraison que s'il y a une toile dans le panier
      noteToiles.hidden = nombreToiles === 0;
      noteDessins.hidden = nombreToiles > 0;
      delai.hidden = p.commande.length === 0;
      const c = calculPanier(p.dessin.length, nombreToiles);
      const l = d.textes.lignes;
      // un sous-total par monde (point vert pour les dessins, orange pour les toiles), puis le total
      const rangs: HTMLElement[] = [];
      if (p.dessin.length) {
        rangs.push(ligne(l.dessins.replace('{n}', String(p.dessin.length)), euros(c.sousTotalDessins), 'dessins'));
        if (c.dessinsOfferts) rangs.push(ligne((c.dessinsOfferts > 1 ? l.lotDessinsPlusieurs : l.lotDessinUn).replace('{n}', String(c.dessinsOfferts)), `−${euros(c.dessinsOfferts * d.prix.dessin)}`, 'dessins'));
      }
      if (nombreToiles) {
        rangs.push(ligne(l.toiles.replace('{n}', String(nombreToiles)), euros(c.sousTotal), 'toiles'));
        if (c.offertes) rangs.push(ligne((c.offertes > 1 ? l.lotPlusieurs : l.lotUne).replace('{n}', String(c.offertes)), `−${euros(c.offertes * d.prix.toile)}`, 'toiles'));
        rangs.push(ligne(nombreToiles > 1 ? l.envoiPlusieurs : l.envoi, c.envoi ? euros(c.envoi) : l.envoiOffert, 'toiles'));
      }
      rangs.push(ligne(l.total, euros(c.total), undefined, true));
      lignes.replaceChildren(...rangs);
    }

    el('[data-vider]').addEventListener('click', vider);
    window.addEventListener('panier-change', rendre);
    rendre();
  }
</script>
<style>
  .panier { max-width: 760px; }
  .panier header { margin-bottom: 14px; }
  .panier header h1 { margin: 0 0 4px; font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.2rem); }
  .panier header .chapeau { margin: 0 auto; font-size: 1rem; }
  .panier__vide { margin-top: 18px; padding: 24px 16px; }
  .panier__liens { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 12px 0 0; }
  .panier__vide[hidden], .panier__carte[hidden] { display: none; }
  /* Un seul grand cadre : un bloc par monde (en-tête et articles), puis le récapitulatif et le total */
  .panier__carte { margin-top: 16px; overflow: hidden; background: #fff; border: var(--trait) solid var(--monde-dessins); border-radius: var(--rayon); box-shadow: var(--ombre); }
  .groupe[hidden] { display: none; }
  .groupe + .groupe { border-top: 2px dashed var(--vert-pale); }
  .groupe__tete { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 10px; padding: 8px 14px; background: var(--vert-creme); }
  .groupe__icone { display: grid; place-items: center; width: 30px; height: 30px; flex: none; color: #fff; background: var(--accent); border-radius: 50%; }
  .groupe__tete h2 { margin: 0; font-size: 1.35rem; }
  .groupe__tete p { margin: 0; font-size: 0.92rem; color: var(--encre-douce); }
  .panier__liste { list-style: none; margin: 0; padding: 0 14px; display: grid; }
  .panier__liste :global(.article) { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 2px dashed var(--vert-pale); }
  .panier__liste :global(.article__lien) { display: grid; grid-template-columns: 56px 1fr; gap: 12px; align-items: center; min-width: 0; text-decoration: none; color: inherit; }
  .panier__liste :global(.article__lien:hover .article__titre) { color: var(--orange-fonce); text-decoration: underline; text-underline-offset: 3px; }
  .panier__liste :global(.article:last-child) { border-bottom: 0; }
  .groupe[data-monde] :global(.article__img) { border-radius: 2px; box-shadow: 0 0 0 1px #9aa2a8, 0 0 0 3px #e9ecee; }
  .panier__liste :global(.article__img) { width: 56px; height: 56px; object-fit: cover; object-position: top; border-radius: 8px 4px 8px 5px / 5px 8px 4px 8px; background: var(--vert-creme); }
  .panier__liste :global(.article__corps) { display: grid; min-width: 0; line-height: 1.2; }
  .panier__liste :global(.article__genre) { font-size: 0.85rem; color: var(--encre-douce); }
  .panier__liste :global(.article__titre) { font-family: var(--titre); font-size: 1.2rem; line-height: 1.15; color: var(--vert-fonce); text-decoration: none; }
  .panier__liste :global(.article__titre:hover) { color: var(--orange-fonce); }
  .panier__liste :global(.article__prix) { font-family: var(--titre); font-size: 1.1rem; color: var(--orange-fonce); }
  .panier__liste :global(.article__retirer) { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; cursor: pointer; color: var(--encre-douce); background: #fff; border: 2px solid var(--vert-pale); border-radius: 50%; }
  .panier__liste :global(.article__retirer:hover) { color: var(--orange-fonce); border-color: var(--orange-fonce); }
  .panier__recap { padding: 10px 14px 12px; background: var(--vert-creme); border-top: var(--trait) solid var(--monde-dessins); }
  .recap__lignes { display: grid; gap: 3px; margin: 0 0 8px; }
  .recap__lignes :global(.ligne) { display: flex; justify-content: space-between; gap: 14px; font-size: 1rem; line-height: 1.3; }
  .recap__lignes :global(.ligne dt), .recap__lignes :global(.ligne dd) { margin: 0; }
  .recap__lignes :global(.ligne[data-m] dt::before) { content: ''; display: inline-block; width: 9px; height: 9px; margin-right: 8px; border-radius: 50%; background: var(--monde-dessins); }
  .recap__lignes :global(.ligne[data-m='toiles'] dt::before) { background: var(--monde-toiles); }
  .recap__lignes :global(.ligne--total) { margin-top: 4px; padding-top: 6px; border-top: 2px dashed var(--vert-pale); font-family: var(--titre); font-size: 1.5rem; color: var(--orange-fonce); }
  .panier__note { margin: 0 0 4px; color: var(--encre-douce); font-size: 0.9rem; line-height: 1.35; }
  .panier__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin: 10px 0 0; }
  .panier__vider { font: inherit; font-size: 0.95rem; padding: 4px; cursor: pointer; color: var(--encre-douce); background: none; border: 0; text-decoration: underline; }
</style>
