---
import Base from '../../layouts/Base.astro';
import { t, chemin, dessins, toiles, type Lang } from '../../i18n';
import { PRIX_DESSIN, PRIX_TOILE } from '../../data/vente';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const chemins = { fr: chemin('contact', 'fr'), nl: chemin('contact', 'nl') };
// Tout ce que le script du formulaire doit écrire vient d'ici, pour que les textes restent dans les dictionnaires.
const donnees = {
  dessins: Object.fromEntries(dessins.map((x) => [x.id, x.titre[lang]])),
  toiles: Object.fromEntries(toiles.map((x) => [x.id, x.titre[lang]])),
  prix: { dessin: PRIX_DESSIN, toile: PRIX_TOILE },
  panier: d.panier,
  modeles: { commande: c.prefillCommande, exposition: c.prefillExposition },
  erreurs: { panierVide: `${c.panierVide} ${c.panierChoisir}`, horsBelgique: c.horsBelgique, codePostal: c.codePostalErreur },
};
const sujets = [
  ['question', c.sujets.question],
  ['commande', c.sujets.commande],
  ['exposition', c.sujets.exposition],
] as const;
---
<Base lang={lang} titre={c.titre} description={c.meta} chemins={chemins}>
  <section class="section">
    <div class="contenu contact">
      <header class="centre">
        <h1>{c.titre}</h1>
        <p class="chapeau">{c.intro}</p>
      </header>
      <form class="formulaire cadre" name="contact" method="POST" action={chemin('merci', lang)} data-netlify="true" netlify-honeypot="bot-field" data-donnees={JSON.stringify(donnees)} data-envoi={c.envoi} data-merci={c.merci} data-erreur={c.erreur}>
        <input type="hidden" name="form-name" value="contact" />
        <p class="piege"><label>Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <label for="nom">{c.nom}</label>
        <input id="nom" name="nom" type="text" autocomplete="name" required />
        <label for="email">{c.email}</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <label for="tel">{c.tel}</label>
        <input id="tel" name="tel" type="tel" autocomplete="tel" />
        <label for="sujet">{c.sujet}</label>
        <select id="sujet" name="sujet">
          {sujets.map(([code, nom]) => <option value={nom} data-code={code}>{nom}</option>)}
        </select>

        <div class="bloc panier-recap" data-pour="commande" hidden>
          <p class="panier-recap__titre">{c.panierTitre}</p>
          <ul class="panier-recap__liste" data-panier-liste></ul>
          <p class="formulaire__note" data-panier-vide hidden>{c.panierVide} {c.panierChoisir}</p>
          <p class="formulaire__note"><a href={chemin('panier', lang)}>{c.panierModifier}</a></p>
          <div class="bloc total" data-panier-total>
            <p><strong>{c.total}</strong> <span data-total></span></p>
            <input type="hidden" name="total" />
            <p class="formulaire__note">{c.totalNote}</p>
          </div>
          <p class="formulaire__note" data-pour="dessin" hidden>{d.panier.livraisonDessin}</p>
          <p class="formulaire__note" data-pour="toile" hidden>{d.panier.livraisonToile}</p>
          <input type="hidden" name="commande" />
        </div>

        <fieldset class="bloc" data-pour="toile" hidden>
          <legend>{c.adresseTitre}</legend>
          <label for="rue">{c.rue}</label>
          <input id="rue" name="rue" type="text" autocomplete="street-address" data-requis />
          <div class="adresse__ligne">
            <div>
              <label for="code-postal">{c.codePostal}</label>
              <input id="code-postal" name="code_postal" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{3}" maxlength="4" title={c.codePostalErreur} data-requis />
            </div>
            <div>
              <label for="localite">{c.localite}</label>
              <input id="localite" name="localite" type="text" autocomplete="address-level2" data-requis />
            </div>
          </div>
          <label for="pays">{c.pays}</label>
          <select id="pays" name="pays">
            <option value={c.paysBelgique}>{c.paysBelgique}</option>
            <option value={c.paysAutre} data-autre>{c.paysAutre}</option>
          </select>
          <p class="erreur" data-hors-belgique role="alert" hidden>{c.horsBelgique}</p>
        </fieldset>

        <p class="conditions" data-pour="dessin" hidden>
          <input id="conditions" name="conditions" type="checkbox" value="oui" data-requis />
          <label for="conditions">{c.conditionsAvant}<a href={chemin('licence', lang)} target="_blank" rel="noopener">{c.conditionsLien}</a>{c.conditionsApres}</label>
        </p>
        <p class="conditions" data-pour="toile" hidden>
          <input id="conditions-toile" name="conditions_toile" type="checkbox" value="oui" data-requis />
          <label for="conditions-toile">{c.conditionsToileAvant}<a href={chemin('conditionsToiles', lang)} target="_blank" rel="noopener">{c.conditionsToileLien}</a>{c.conditionsToileApres}</label>
        </p>
        <label for="message">{c.message}</label>
        <textarea id="message" name="message" rows="8" required placeholder={c.placeholder}></textarea>
        <button class="bouton" type="submit">{c.envoyer}</button>
        <p class="formulaire__etat" role="status" aria-live="polite"></p>
        <p class="formulaire__note">{c.reponse}</p>
      </form>
    </div>
  </section>
</Base>
<script>
  import { lire } from '../panier';
  import { calculPanier } from '../../data/vente';
  interface Donnees {
    dessins: Record<string, string>;
    toiles: Record<string, string>;
    prix: { dessin: number; toile: number };
    panier: {
      lignes: { lotUne: string; lotPlusieurs: string; envoi: string; envoiOffert: string };
      ligneDessin: string; ligneToile: string; ligneCommande: string;
    };
    modeles: { commande: string; exposition: string };
    erreurs: { panierVide: string; horsBelgique: string; codePostal: string };
  }
  const form = document.querySelector<HTMLFormElement>('form.formulaire');
  if (form) {
    const donnees = JSON.parse(form.dataset.donnees ?? '{}') as Donnees;
    const champ = <T extends Element>(s: string) => form.querySelector<T>(s)!;
    const sujet = champ<HTMLSelectElement>('#sujet');
    const message = champ<HTMLTextAreaElement>('#message');
    const pays = champ<HTMLSelectElement>('#pays');
    const codePostal = champ<HTMLInputElement>('#code-postal');
    const horsBelgique = champ<HTMLElement>('[data-hors-belgique]');
    const liste = champ<HTMLElement>('[data-panier-liste]');
    const code = () => sujet.selectedOptions[0]?.dataset.code ?? 'question';

    // Le message est pré-écrit tant que le visiteur ne l'a pas modifié lui-même.
    let messageAuto = '';
    function preEcrire(texte: string) {
      if (message.value === '' || message.value === messageAuto) message.value = texte;
      messageAuto = texte;
    }

    // Le panier du visiteur, en lignes de texte (articles qui existent encore seulement) et son total.
    function panier() {
      const p = lire();
      const ligne = (modele: string, titre: string, prix: number) => modele.replace('{t}', titre).replace('{p}', String(prix));
      const lignes = [
        ...p.dessin.filter((id) => donnees.dessins[id]).map((id) => ligne(donnees.panier.ligneDessin, donnees.dessins[id], donnees.prix.dessin)),
        ...p.toile.filter((id) => donnees.toiles[id]).map((id) => ligne(donnees.panier.ligneToile, donnees.toiles[id], donnees.prix.toile)),
        ...p.commande.filter((id) => donnees.dessins[id]).map((id) => ligne(donnees.panier.ligneCommande, donnees.dessins[id], donnees.prix.toile)),
      ];
      const dessins = p.dessin.filter((id) => donnees.dessins[id]).length;
      const nbToiles = p.toile.filter((id) => donnees.toiles[id]).length + p.commande.filter((id) => donnees.dessins[id]).length;
      const k = calculPanier(dessins, nbToiles);
      const l = donnees.panier.lignes;
      const details = [k.offertes ? (k.offertes > 1 ? l.lotPlusieurs : l.lotUne).replace('{n}', String(k.offertes)) : '', nbToiles ? (k.envoi ? `${l.envoi} ${k.envoi} €` : l.envoiOffert) : ''].filter(Boolean);
      return { lignes, dessins, toiles: nbToiles, total: lignes.length ? `${k.total} €${details.length ? ` (${details.join(' · ')})` : ''}` : '' };
    }

    function majFormulaire() {
      const s = code();
      const p = panier();
      // blocs : par demande, et pour une commande selon ce que contient le panier (adresse seulement s'il y a une toile)
      const actifs = new Set([s]);
      if (s === 'commande' && p.toiles) actifs.add('toile');
      if (s === 'commande' && p.dessins) actifs.add('dessin');
      form!.querySelectorAll<HTMLElement>('[data-pour]').forEach((b) => { b.hidden = !b.dataset.pour!.split(' ').some((x) => actifs.has(x)); });
      form!.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-requis]').forEach((x) => { x.required = !x.closest('[hidden]'); });
      liste.replaceChildren(...p.lignes.map((texte) => Object.assign(document.createElement('li'), { textContent: texte })));
      champ<HTMLElement>('[data-panier-vide]').hidden = p.lignes.length > 0;
      champ<HTMLElement>('[data-panier-total]').hidden = p.lignes.length === 0;
      champ('[data-total]').textContent = p.total;
      champ<HTMLInputElement>('input[name=total]').value = s === 'commande' ? p.total : '';
      champ<HTMLInputElement>('input[name=commande]').value = s === 'commande' ? p.lignes.join('\n') : '';
      // Une commande demande un panier non vide, et une livraison en Belgique seulement.
      sujet.setCustomValidity(s === 'commande' && p.lignes.length === 0 ? donnees.erreurs.panierVide : '');
      const ailleurs = !!pays.selectedOptions[0]?.hasAttribute('data-autre') && actifs.has('toile');
      pays.setCustomValidity(ailleurs ? donnees.erreurs.horsBelgique : '');
      horsBelgique.hidden = !ailleurs;
      let texte = '';
      if (s === 'commande' && p.lignes.length) texte = donnees.modeles.commande.replace('{liste}', p.lignes.map((x) => `- ${x}`).join('\n')).replace('{total}', p.total);
      if (s === 'exposition') texte = donnees.modeles.exposition;
      preEcrire(texte);
    }

    // Arrivée depuis un lien : ?sujet=commande (le panier), ?sujet=exposition ; sinon, un panier rempli ouvre la commande
    const voulu = new URLSearchParams(location.search).get('sujet') ?? (panier().lignes.length ? 'commande' : '');
    const option = [...sujet.options].find((o) => o.dataset.code === voulu);
    if (option) sujet.value = option.value;
    [sujet, pays].forEach((x) => x.addEventListener('change', majFormulaire));
    window.addEventListener('panier-change', majFormulaire);
    codePostal.addEventListener('input', () => codePostal.setCustomValidity(''));
    codePostal.addEventListener('invalid', () => codePostal.setCustomValidity(codePostal.validity.patternMismatch ? donnees.erreurs.codePostal : ''));
    majFormulaire();

    const etat = form.querySelector<HTMLElement>('.formulaire__etat')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const bouton = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      bouton.disabled = true;
      etat.textContent = form.dataset.envoi ?? '';
      try {
        const corps = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
        const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: corps });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        messageAuto = '';
        majFormulaire();
        etat.textContent = form.dataset.merci ?? '';
        etat.className = 'formulaire__etat ok';
      } catch {
        etat.textContent = form.dataset.erreur ?? '';
        etat.className = 'formulaire__etat ko';
      } finally {
        bouton.disabled = false;
      }
    });
  }
</script>
<style>
  .contact { max-width: 760px; }
  .formulaire { display: grid; gap: 8px; padding: clamp(20px, 4vw, 38px); margin-top: 30px; }
  .formulaire label, .formulaire legend { font-family: var(--titre); font-size: 1.3rem; color: var(--vert-fonce); margin-top: 10px; }
  .formulaire input, .formulaire select, .formulaire textarea { font: inherit; font-size: 1.1rem; padding: 12px 14px; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); background: #fff; color: var(--encre); width: 100%; }
  .formulaire input:focus, .formulaire select:focus, .formulaire textarea:focus { outline: 3px dashed var(--orange-fonce); outline-offset: 2px; }
  .bloc { display: grid; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .bloc[hidden], .formulaire [data-pour][hidden] { display: none; }
  .formulaire legend { padding: 0; }
  .conditions input { appearance: none; -webkit-appearance: none; flex: none; width: 30px; height: 30px; margin: 2px 0 0; padding: 0; cursor: pointer; background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 12px 6px 11px 7px / 7px 11px 6px 12px; transition: transform 0.15s, background-color 0.15s; display: grid; place-items: center; }
  .conditions input:checked { background: var(--vert-creme); }
  .conditions input:checked::after { content: ''; width: 18px; height: 11px; margin-top: -4px; border-left: 4.5px solid var(--orange-fonce); border-bottom: 4.5px solid var(--orange-fonce); border-radius: 2px 0 3px 2px; transform: rotate(-48deg); }
  .panier-recap { padding: 14px 16px; background: var(--vert-creme); border-radius: var(--rayon-petit); }
  .panier-recap__titre { margin: 0; font-family: var(--titre); font-size: 1.3rem; color: var(--vert-fonce); }
  .panier-recap__liste { margin: 0; padding-left: 20px; }
  .total { margin-top: 12px; padding: 12px 16px; background: var(--orange-creme); border-radius: var(--rayon-petit); }
  .total p { margin: 0; }
  .total strong { font-family: var(--titre); font-weight: 400; font-size: 1.3rem; color: var(--orange-fonce); }
  .adresse__ligne { display: grid; grid-template-columns: 9em 1fr; gap: 12px; }
  .adresse__ligne > div { display: grid; gap: 8px; }
  .erreur { margin: 4px 0 0; color: #a12a1a; font-weight: 600; }
  .conditions { display: flex; gap: 12px; align-items: flex-start; margin: 14px 0 0; }
  .conditions input:hover { transform: rotate(-4deg) scale(1.06); }
  .conditions label { font-family: var(--texte); font-size: 1.05rem; color: var(--encre); margin: 0; cursor: pointer; }
  .formulaire .bouton { justify-self: start; margin-top: 18px; }
  .formulaire .bouton:disabled { opacity: 0.6; cursor: wait; }
  .formulaire__etat { min-height: 1.6em; margin: 6px 0 0; font-weight: 600; }
  .formulaire__etat.ok { color: var(--vert-fonce); } .formulaire__etat.ko { color: #a12a1a; }
  .formulaire__note { margin: 0; color: var(--encre-douce); font-size: 0.98rem; }
  .piege { position: absolute; left: -9999px; }
</style>
