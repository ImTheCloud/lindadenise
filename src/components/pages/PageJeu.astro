---
import Base from '../../layouts/Base.astro';
import Etang from '../Etang.astro';
import Arbre from '../Arbre.astro';
import { t, chemin, type Lang } from '../../i18n';
import { FEUILLE, NERVURES } from '../tilleul/formes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const j = t(lang).jeu;
const chemins = { fr: chemin('jeu', 'fr'), nl: chemin('jeu', 'nl') };
const ordres = ['marche', 'assis', 'couche', 'dort', 'etire', 'feuille'] as const;
// ordres qui demandent du mouvement : cachés quand le visiteur a demandé moins d'animations
const bouge = new Set(['marche', 'feuille']);
// petites icônes dessinées (40 × 40), en couleur du texte
const icones: Record<(typeof ordres)[number], string> = {
  marche: '<g fill="currentColor"><ellipse cx="12" cy="27" rx="5" ry="4"/><circle cx="7" cy="21" r="2"/><circle cx="11" cy="19" r="2"/><circle cx="15" cy="19" r="2"/><circle cx="18" cy="22" r="2"/><ellipse cx="27" cy="15" rx="5" ry="4"/><circle cx="22" cy="9" r="2"/><circle cx="26" cy="7" r="2"/><circle cx="30" cy="7" r="2"/><circle cx="33" cy="10" r="2"/></g>',
  assis: '<path fill="currentColor" d="M13,35 C9,27 11,19 15,16 L14,7 L19,12 L23,12 L28,7 L27,16 C31,19 32,27 28,35 Z"/><path d="M28,34 C34,34 36,29 33,25" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
  couche: '<path fill="currentColor" d="M8,32 C8,25 13,22 20,23 L29,23 L30,16 L34,20 L37,16 L37,25 C37,29 35,32 31,32 Z"/><path d="M9,31 C3,31 3,25 6,23" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>',
  dort: '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20h11l-11 13h11" stroke-width="3"/><path d="M19 10h9l-9 10h9" stroke-width="2.6"/><path d="M29 3h6l-6 7h6" stroke-width="2.2"/></g>',
  etire: '<path d="M5,20 H35 M5,20 l7,-7 M5,20 l7,7 M35,20 l-7,-7 M35,20 l-7,7" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>',
  feuille: `<g transform="translate(20,20) rotate(-20) scale(.36) translate(-50,-50)"><path fill="currentColor" d="${FEUILLE}"/><path d="${NERVURES}" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none"/></g>`,
};
const textes = JSON.stringify({ fin0: j.fin0, fin1: j.fin1, finN: j.finN, meilleur: j.meilleur, poisson: j.poisson });
// touffes d'herbe au bord de l'étang (là où on touche pour appeler Tilleul)
const herbe = Array.from({ length: 24 }, (_, i) => { const x = i * 60 + (i % 3) * 9; return `M${x},40 C${x + 2},26 ${x + 6},18 ${x + 3},6 M${x + 9},40 C${x + 10},30 ${x + 14},24 ${x + 18},16 M${x + 16},40 C${x + 17},32 ${x + 22},28 ${x + 27},26`; }).join(' ');
---
<Base lang={lang} titre={j.titre} description={j.meta} chemins={chemins}>
  <section class="jeu" data-jeu data-decor data-textes={textes}>
    <Arbre />
    <div class="contenu">
      <div class="jeu__panneau">
        <h1 class="jeu__titre">{j.titre}</h1>
        <div class="jeu__libre">
          <p class="jeu__intro">{j.intro}</p>
          <div class="jeu__ordres">
            {ordres.map((o) => (
              <button class="jeu__ordre" type="button" data-ordre={o} data-bouge={bouge.has(o) ? '' : undefined} aria-pressed="false">
                <svg viewBox="0 0 40 40" aria-hidden="true" set:html={icones[o]} />
                <span>{j[o]}</span>
              </button>
            ))}
            <button class="bouton jeu__lancer" type="button" data-bouge data-lancer>{j.jouer}</button>
          </div>
          <p class="jeu__reduit" hidden>{j.reduit}</p>
        </div>
        <div class="jeu__partie" hidden>
          <p class="jeu__regle">{j.regle}</p>
          <div class="jeu__compteurs">
            <p class="jeu__compteur"><span class="jeu__nombre" data-score>0</span> <span>{j.score}</span></p>
            <p class="jeu__compteur"><span class="jeu__nombre" data-temps>30</span> <span>{j.temps}</span></p>
            <p class="jeu__compteur jeu__compteur--record"><span class="jeu__nombre" data-record>0</span> <span>{j.record}</span></p>
          </div>
          <p class="jeu__fin" data-fin hidden></p>
          <div class="jeu__boutons">
            <button class="bouton bouton--contour" type="button" data-arreter>{j.arreter}</button>
            <button class="bouton" type="button" data-rejouer hidden>{j.rejouer}</button>
            <button class="bouton bouton--contour" type="button" data-retour hidden>{j.retour}</button>
          </div>
        </div>
      </div>
    </div>
    <Etang />
    <div class="jeu__ciel" aria-hidden="true"></div>
    <div class="jeu__sol" aria-hidden="true">
      <svg class="jeu__herbe" viewBox="0 0 1440 40" preserveAspectRatio="none"><path d={herbe} fill="none" stroke="#2B6E3A" stroke-width="4" stroke-linecap="round" /></svg>
    </div>
    <div data-tilleul-rail></div>
    <template data-modele="feuille">
      <svg class="jeu__feuille" viewBox="0 0 100 100"><path d={FEUILLE} /><path d={NERVURES} stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none" opacity=".6" /></svg>
    </template>
    <template data-modele="poisson">
      <button class="poisson" type="button" tabindex="-1">
        <svg viewBox="0 0 60 36" aria-hidden="true">
          <path d="M10,18 L1,6 C5,12 5,24 1,30 Z" fill="#F7992B" stroke="#8B3E12" stroke-width="2" stroke-linejoin="round" />
          <path d="M24,9 C28,2 37,2 41,9 Z" fill="#F7992B" stroke="#8B3E12" stroke-width="2" stroke-linejoin="round" />
          <path d="M9,18 C15,6 35,2 48,10 C56,14 58,22 48,26 C35,34 15,30 9,18 Z" fill="#F28A1E" stroke="#8B3E12" stroke-width="2.2" stroke-linejoin="round" />
          <path d="M17,22 C27,28 40,26 47,22 C39,25 27,26 17,22 Z" fill="#FFD08A" />
          <path d="M22,14 C25,17 25,21 22,24 M29,13 C32,17 32,21 29,25" fill="none" stroke="#C8571B" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="47" cy="15" r="2.4" fill="#2B3B2B" /><circle cx="47.8" cy="14.2" r=".8" fill="#fff" />
        </svg>
      </button>
    </template>
  </section>
</Base>
<script>
  import { lien } from '../tilleul/lien';
  import type { FeuilleDecor, Ordre } from '../tilleul/chat';

  const scene = document.querySelector<HTMLElement>('.jeu');
  if (scene) {
    const textes = JSON.parse(scene.dataset.textes ?? '{}') as { fin0: string; fin1: string; finN: string; meilleur: string; poisson: string };
    const ciel = scene.querySelector<HTMLElement>('.jeu__ciel')!;
    const sol = scene.querySelector<HTMLElement>('.jeu__sol')!;
    const couronne = scene.querySelector<SVGSVGElement>('[data-couronne]')!;
    const libre = scene.querySelector<HTMLElement>('.jeu__libre')!;
    const panneauPartie = scene.querySelector<HTMLElement>('.jeu__partie')!;
    const champ = <T extends Element>(sel: string) => scene.querySelector<T>(sel)!;
    const scoreEl = champ<HTMLElement>('[data-score]'), tempsEl = champ<HTMLElement>('[data-temps]'), recordEl = champ<HTMLElement>('[data-record]'), finEl = champ<HTMLElement>('[data-fin]');
    const lancer = champ<HTMLButtonElement>('[data-lancer]'), arreter = champ<HTMLButtonElement>('[data-arreter]'), rejouer = champ<HTMLButtonElement>('[data-rejouer]'), retour = champ<HTMLButtonElement>('[data-retour]');
    const boutons = [...scene.querySelectorAll<HTMLButtonElement>('[data-ordre]')];
    const modele = (nom: string) => scene.querySelector<HTMLTemplateElement>(`[data-modele="${nom}"]`)!.content.firstElementChild!;
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CLE = 'tilleul-record-poissons';
    const lireRecord = () => { try { return Number(localStorage.getItem(CLE)) || 0; } catch { return 0; } };
    const ecrireRecord = (n: number) => { try { localStorage.setItem(CLE, String(n)); } catch { /* sans stockage : record gardé le temps de la visite */ } };
    let record = lireRecord();
    const hasard = (a: number, b: number) => a + Math.random() * (b - a);

    // Moins d'animations : le chat change de pose sans bouger, rien ne tombe ni ne saute
    if (reduit) {
      scene.querySelectorAll<HTMLElement>('[data-bouge]').forEach((b) => { b.hidden = true; });
      champ<HTMLElement>('.jeu__reduit').hidden = false;
    }

    // Mesures de la scène, relevées quand sa taille change (positions dans la scène ; l'écran s'en déduit au défilement)
    let haut = 0, defile = scrollY, largeur = 0, hauteur = 0, zone = { x0: 0, x1: 0, y0: 0, y1: 0 };
    const relever = () => {
      defile = scrollY;
      const r = scene.getBoundingClientRect(), c = couronne.getBoundingClientRect();
      haut = r.top + defile;
      largeur = r.width;
      hauteur = r.height;
      // les feuilles se détachent du bas du feuillage
      zone = { x0: Math.max(80, c.left + c.width * 0.2), x1: Math.min(largeur - 80, c.left + c.width * 0.8), y0: c.top - r.top + c.height * 0.6, y1: c.top - r.top + c.height * 0.76 };
    };
    relever();
    new ResizeObserver(relever).observe(scene);
    // position de la page relue quand le défilement s'arrête (aucune lecture de mise en page pendant qu'on défile)
    let arret: number | undefined;
    addEventListener('scroll', () => { window.clearTimeout(arret); arret = window.setTimeout(() => { defile = scrollY; }, 120); }, { passive: true });
    const ecran = (y: number) => haut - defile + y; // de la scène à l'écran
    // où est le chat (repères de Mascotte.astro), dans la scène : tête, sol, échelle
    const chat = () => {
      const r = lien.reperes;
      if (!r) return { x: largeur / 2, sol: hauteur - 4, s: 0.72 };
      return { x: r.tete.x, sol: r.haut - ecran(0) + 276, s: r.s };
    };

    // Une feuille : elle se détache du feuillage, prend de la vitesse puis tombe régulièrement en se balançant ;
    // Tilleul va la chercher (au trot si elle est loin) et bondit dessus
    interface Feuille { el: Element; x0: number; x: number; y: number; vy: number; ph: number }
    let feuilles: Feuille[] = [];
    const couleurs = ['#3E9A47', '#F28A1E', '#2B6E3A', '#FFB347'];
    const lacher = () => {
      const el = modele('feuille').cloneNode(true) as Element;
      el.setAttribute('fill', couleurs[Math.floor(Math.random() * couleurs.length)]);
      ciel.append(el);
      // elle tombe plutôt du côté de Tilleul
      const x = Math.min(Math.max(chat().x + hasard(-0.15, 0.15) * largeur, zone.x0), zone.x1);
      const f: Feuille = { el, x0: x, x, y: hasard(zone.y0, zone.y1), vy: 0, ph: hasard(0, 6) };
      feuilles.push(f);
      return f;
    };
    const enlever = (f: Feuille, classe: string) => {
      f.el.classList.add(classe);
      feuilles = feuilles.filter((x) => x !== f);
      window.setTimeout(() => f.el.remove(), 450);
    };
    // un rond dans l'eau
    const plouf = (x: number, y: number) => {
      const p = document.createElement('div');
      p.className = 'jeu__plouf';
      p.style.transform = `translate(${x}px, ${y}px)`;
      ciel.append(p);
      p.addEventListener('animationend', () => p.remove());
    };
    lien.feuilles = (): FeuilleDecor[] => feuilles.map((f) => ({ el: f.el, x: f.x, y: ecran(f.y), vy: f.vy, attraper: () => enlever(f, 'attrapee') }));

    boutons.forEach((b) => b.addEventListener('click', () => {
      const o = b.dataset.ordre!;
      if (o === 'feuille') lien.chat?.ordre('chasse', { cible: lacher().el });
      else lien.chat?.ordre(o as Ordre);
    }));

    // Toucher l'herbe : Tilleul vient ; une petite trace de patte montre l'endroit
    sol.addEventListener('pointerdown', (e) => {
      if (reduit || !lien.chat) return;
      lien.chat.ordre('viens', { x: e.clientX });
      const trace = document.createElement('div');
      trace.className = 'jeu__trace';
      trace.style.transform = `translate(${e.clientX}px, ${e.clientY - ecran(0)}px)`;
      ciel.append(trace);
      trace.addEventListener('animationend', () => trace.remove());
    });

    // ---------- mini-jeu : attraper les poissons ----------
    // Des poissons sautent de l'étang en arc ; on les touche avant qu'ils replongent. Tilleul les suit des yeux
    // et fait un petit bond de joie à chaque poisson attrapé. De plus en plus de poissons, un peu plus rapides.
    interface Poisson { el: HTMLElement; x0: number; dx: number; y0: number; h: number; t: number; d: number }
    let poissons: Poisson[] = [];
    const DUREE = 30;
    let partie: { t: number; score: number; prochaine: number; temps: number } | null = null;
    const sauter = (u: number) => {
      const el = modele('poisson').cloneNode(true) as HTMLElement;
      el.setAttribute('aria-label', textes.poisson);
      ciel.append(el);
      const c = chat(), x0 = hasard(70, largeur - 70), dx = hasard(-0.18, 0.18) * largeur;
      const p: Poisson = { el, x0, dx: Math.min(Math.max(x0 + dx, 50), largeur - 50) - x0, y0: c.sol - 18, h: hauteur * hasard(0.3, 0.52), t: 0, d: 2.3 - 0.8 * u };
      if (p.dx < 0) el.classList.add('poisson--gauche');
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        if (!partie || !poissons.includes(p)) return;
        partie.score += 1;
        scoreEl.textContent = String(partie.score);
        el.classList.add('pris');
        poissons = poissons.filter((x) => x !== p);
        window.setTimeout(() => el.remove(), 400);
        lien.chat?.fete();
      });
      poissons.push(p);
    };
    const montrer = (enPartie: boolean) => {
      libre.hidden = enPartie;
      panneauPartie.hidden = !enPartie;
    };
    const commencer = () => {
      partie = { t: 0, score: 0, prochaine: 0.5, temps: DUREE };
      scoreEl.textContent = '0';
      tempsEl.textContent = String(DUREE);
      recordEl.textContent = String(record);
      finEl.hidden = true;
      arreter.hidden = false;
      rejouer.hidden = retour.hidden = true;
      montrer(true);
      lien.chat?.enPartie(true);
      if (scene.getBoundingClientRect().top < 0) scrollTo({ top: 0 });
      arreter.focus();
    };
    const terminer = (fini: boolean) => {
      const p = partie;
      partie = null;
      lien.chat?.enPartie(false);
      if (!p) return;
      if (!fini) { montrer(false); return; }
      const nouveau = p.score > record;
      if (nouveau) { record = p.score; ecrireRecord(record); recordEl.textContent = String(record); }
      finEl.textContent = (p.score === 0 ? textes.fin0 : p.score === 1 ? textes.fin1 : textes.finN.replace('{n}', String(p.score))) + (nouveau ? ` ${textes.meilleur}` : '');
      finEl.hidden = false;
      arreter.hidden = true;
      rejouer.hidden = retour.hidden = false;
      rejouer.focus();
    };
    lancer.addEventListener('click', commencer);
    rejouer.addEventListener('click', commencer);
    arreter.addEventListener('click', () => terminer(false));
    retour.addEventListener('click', () => { montrer(false); lancer.focus(); });

    // ce qu'il suit des yeux : le poisson le plus haut, sinon la feuille la plus basse
    let regard: { x: number; y: number } | null = null;
    lien.curiosite = () => regard;

    // ---------- une image ----------
    let avant = 0, actif = '';
    const boucle = (t: number) => {
      const dt = avant ? Math.min(0.05, (t - avant) / 1000) : 0;
      avant = t;
      const c = chat();

      if (partie) {
        partie.t += dt;
        const u = Math.min(1, partie.t / DUREE);
        if (partie.t >= partie.prochaine && partie.t < DUREE - 1.2) {
          sauter(u);
          partie.prochaine += 1.05 - 0.5 * u;
        }
        const reste = Math.max(0, Math.ceil(DUREE - partie.t));
        if (reste !== partie.temps) { partie.temps = reste; tempsEl.textContent = String(reste); }
        if (partie.t >= DUREE) terminer(true);
      }

      // poissons : un arc, le nez suit la trajectoire ; celui qui retombe dans l'eau fait un rond
      for (const p of [...poissons]) {
        p.t += dt;
        const k = p.t / p.d;
        if (k >= 1 || !partie) {
          plouf(p.x0 + p.dx, p.y0);
          p.el.remove();
          poissons = poissons.filter((x) => x !== p);
          continue;
        }
        const x = p.x0 + p.dx * k, y = p.y0 - 4 * p.h * k * (1 - k);
        p.el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) rotate(${((k - 0.5) * 110 * Math.sign(p.dx || 1)).toFixed(1)}deg)`;
      }

      // feuilles : elles prennent de la vitesse puis tombent régulièrement ; celle qui touche l'eau fait un rond
      const chute = 0.09 * innerHeight;
      for (const f of [...feuilles]) {
        f.ph += dt;
        f.vy += (chute - f.vy) * Math.min(1, dt * 2.5);
        f.y += f.vy * dt;
        f.x = f.x0 + 26 * Math.sin(f.ph * 1.3);
        (f.el as SVGElement).style.transform = `translate(${f.x.toFixed(1)}px, ${f.y.toFixed(1)}px) rotate(${(28 * Math.sin(f.ph * 1.3 + 1)).toFixed(1)}deg)`;
        if (f.y >= c.sol - 20) { plouf(f.x, f.y); enlever(f, 'coulee'); }
      }

      const haut1 = poissons.reduce<Poisson | null>((m, p) => (!m || p.t / p.d < 0.5 ? p : m), null);
      const basse = feuilles.reduce<Feuille | null>((m, f) => (!m || f.y > m.y ? f : m), null);
      if (haut1) { const k = haut1.t / haut1.d; regard = { x: haut1.x0 + haut1.dx * k, y: ecran(haut1.y0 - 4 * haut1.h * k * (1 - k)) }; }
      else regard = basse ? { x: basse.x, y: ecran(basse.y) } : null;

      // le bouton de ce que fait Tilleul est allumé
      const a = lien.chat?.action ?? '';
      const maintenant = a === 'chasse' ? 'feuille' : a;
      if (maintenant !== actif) {
        actif = maintenant;
        boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ordre === actif)));
      }
      requestAnimationFrame(boucle);
    };
    requestAnimationFrame(boucle);
  }
</script>
<style>
  /* La scène tient dans l'écran : l'arbre en haut (à gauche sur grand écran), le panneau, l'étang en bas où vit Tilleul */
  .jeu { position: relative; overflow: hidden; overflow: clip; min-height: calc(100svh - 68px); padding: 21vw 0 clamp(158px, 22vw, 300px); background: linear-gradient(#fff 55%, #f6fbf6); }
  .jeu__panneau { position: relative; z-index: 2; max-width: 560px; margin-inline: auto; padding: 12px 14px 12px; background: rgba(255, 255, 255, 0.94); border: var(--trait) solid var(--vert-pale); border-radius: var(--rayon); }
  .jeu__titre { font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem); margin: 0; text-align: center; }
  .jeu__intro { margin: 2px 0 10px; text-align: center; color: var(--encre-douce); font-size: 1.02rem; line-height: 1.3; }
  .jeu__ordres { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .jeu__ordre { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-height: 60px; padding: 5px 4px; font-family: var(--titre); font-size: 1.15rem; line-height: 1.05; color: var(--vert-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); box-shadow: 0 4px 0 rgba(43, 110, 58, 0.3); cursor: pointer; transition: transform 0.15s, background 0.15s, color 0.15s; }
  .jeu__ordre svg { width: 28px; height: 28px; flex: none; }
  .jeu__ordre:hover { color: var(--orange-fonce); border-color: var(--orange-fonce); }
  .jeu__ordre:active { transform: translateY(3px); box-shadow: 0 1px 0 rgba(43, 110, 58, 0.3); }
  .jeu__ordre[aria-pressed='true'] { color: #fff; background: var(--vert-fonce); border-color: #173f20; box-shadow: 0 4px 0 #173f20; }
  .jeu__ordre[hidden], .jeu__lancer[hidden] { display: none; }
  .jeu__lancer { grid-column: 1 / -1; justify-content: center; margin-top: 4px; }
  .jeu__reduit, .jeu__regle { margin: 6px 0; text-align: center; color: var(--encre-douce); line-height: 1.3; }
  .jeu__compteurs { display: flex; justify-content: center; gap: clamp(14px, 5vw, 36px); margin: 4px 0; }
  .jeu__compteur { display: flex; flex-direction: column; align-items: center; margin: 0; font-family: var(--titre); font-size: 1.1rem; color: var(--encre-douce); line-height: 1; }
  .jeu__nombre { font-size: clamp(2.8rem, 2rem + 4vw, 4rem); color: var(--vert-fonce); line-height: 1; }
  .jeu__compteur--record .jeu__nombre { color: var(--orange-fonce); }
  .jeu__fin { margin: 6px 0; text-align: center; font-size: 1.15rem; line-height: 1.35; }
  .jeu__boutons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .jeu__boutons [hidden] { display: none; }

  /* Ce qui tombe et ce qui saute passe devant le panneau ; seuls les poissons se touchent */
  .jeu__ciel { position: absolute; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
  .jeu__ciel :global(.jeu__feuille) { position: absolute; left: -17px; top: -17px; width: 34px; height: 34px; will-change: transform; transition: opacity 0.35s, scale 0.35s; }
  .jeu__ciel :global(.attrapee) { opacity: 0; scale: 0.2; }
  .jeu__ciel :global(.coulee) { opacity: 0; }
