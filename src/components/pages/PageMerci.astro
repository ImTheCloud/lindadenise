---
import Base from '../../layouts/Base.astro';
import { t, chemin, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const chemins = { fr: chemin('merci', 'fr'), nl: chemin('merci', 'nl') };
---
<Base lang={lang} titre={d.merci.titre} chemins={chemins} mascotte="contact" noindex>
  <section class="section centre" data-mascotte="contact">
    <div class="contenu">
      <h1>{d.merci.titre}</h1>
      <p class="chapeau">{d.merci.texte}</p>
      <p><a class="bouton bouton--vert" href={chemin('accueil', lang)}>{d.merci.retour}</a></p>
    </div>
  </section>
</Base>
