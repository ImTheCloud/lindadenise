---
import Base from '../../layouts/Base.astro';
import CarteToile from '../CarteToile.astro';
import Etapes from '../Etapes.astro';
import Salon from '../Salon.astro';
import { t, chemin, cheminToile, toiles, type Toile, type Lang } from '../../i18n';
import { PRIX_TOILE, FRAIS_ENVOI, ENVOI_OFFERT_DES } from '../../data/vente';
interface Props { lang: Lang; toile: Toile }
const { lang, toile } = Astro.props;
const d = t(lang);
const tt = d.toiles;
const titre = toile.titre[lang];
const alt = tt.altDe(titre, toile.description[lang]);
const chemins = { fr: cheminToile(toile.id, 'fr'), nl: cheminToile(toile.id, 'nl') };
const i = toiles.findIndex((x) => x.id === toile.id);
const prec = toiles[(i - 1 + toiles.length) % toiles.length];
const suiv = toiles[(i + 1) % toiles.length];
// Toiles à voir aussi : celles qui suivent celle-ci (différentes d'une fiche à l'autre).
const autres = [...toiles.slice(i + 1), ...toiles.slice(0, i)].slice(0, 4);
const vignette = (x: Toile) => `/toiles/${x.id}-400.webp`;
---
<Base lang={lang} monde="toiles" titre={titre} description={`${alt} · ${tt.prix(PRIX_TOILE)}`} chemins={chemins} image={`/toiles/${toile.id}-800.jpg`}>
  <section class="section section--fiche">
    <div class="contenu">
      <p><a href={chemin('toiles', lang)}>{tt.retour}</a></p>
      <div class="fiche">
        <div class="fiche__image cadre">
          <button type="button" class="fiche__zoom" data-zoom aria-label={tt.agrandir}>
            <picture>
              <source type="image/avif" srcset={[400, 800, 1000].map((l) => `/toiles/${toile.id}-${l}.avif ${l}w`).join(', ')} sizes="(min-width: 860px) 45vw, 92vw" />
              <source type="image/webp" srcset={[400, 800, 1000].map((l) => `/toiles/${toile.id}-${l}.webp ${l}w`).join(', ')} sizes="(min-width: 860px) 45vw, 92vw" />
              <img src={`/toiles/${toile.id}-800.jpg`} width="400" height="566" alt={alt} decoding="async" fetchpriority="high" />
            </picture>
          </button>
        </div>
        <div class="fiche__infos">
          <p class="surtitre">{tt.surtitre} · <a href={`${chemin('toiles', lang)}#${toile.rubrique}`}>{d.rubriques[toile.rubrique].court}</a></p>
          <h1>{titre}</h1>
          <p class="fiche__prix">{toile.vendue ? tt.vendue : tt.prix(PRIX_TOILE)}</p>
          <p>{toile.vendue ? tt.vendueTexte : tt.caracteristiques}</p>
          {toile.vendue ? <p class="fiche__vendue">{tt.vendueTexte}</p> : (
            <p class="fiche__panier">
              <button type="button" class="bouton" aria-pressed="false" data-panier={`toile:${toile.id}`} data-ajouter={d.panier.ajouter} data-dedans={d.panier.dedans}>{d.panier.ajouter}</button>
              <a href={chemin('panier', lang)}>{d.panier.voir}</a>
            </p>
          )}
          <p class="fiche__petit"><a href={chemin('conditionsToiles', lang)}>{tt.conditions}</a> · <a href="#echelle">{tt.echelle}</a></p>
          <nav class="fiche__nav" aria-label="Navigation">
            <a href={cheminToile(prec.id, lang)} rel="prev">
              <img src={vignette(prec)} width="60" height="84" alt="" loading="lazy" />
              <span>← {tt.precedent}</span>
            </a>
            <a href={cheminToile(suiv.id, lang)} rel="next">
              <img src={vignette(suiv)} width="60" height="84" alt="" loading="lazy" />
              <span>{tt.suivant} →</span>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--vert" id="echelle">
    <div class="contenu salon-bloc">
      <h2>{tt.echelle}</h2>
    <Salon lang={lang} ids={[toile.id]} />
    </div>
  </section>
  <section class="section section--orange">
    <div class="contenu"><Etapes titre={tt.commanderTitre} etapes={tt.etapes} /></div>
  </section>
  <section class="section">
    <div class="contenu">
      <h2 class="centre">{tt.autres}</h2>
      <div class="suite">
        {autres.map((x) => <CarteToile toile={x} lang={lang} />)}
      </div>
    </div>
  </section>
  <dialog class="zoom" id="zoom" aria-label={titre}>
    <button type="button" class="zoom__fermer" data-fermer aria-label={tt.fermer}>×</button>
    <img src={`/toiles/${toile.id}-1000.webp`} alt={alt} width="1000" height="1414" />
  </dialog>
</Base>

<script>
  const zoom = document.querySelector<HTMLDialogElement>('#zoom');
  document.querySelector('[data-zoom]')?.addEventListener('click', () => zoom?.showModal());
  zoom?.addEventListener('click', () => zoom.close());
</script>

<style>
  .fiche__zoom { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .zoom { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100svh; width: 100%; height: 100%; overflow: hidden; }
  .zoom::backdrop { background: rgba(20, 30, 22, 0.88); }
  .zoom[open] { display: grid; place-items: center; cursor: zoom-out; }
  .zoom img { width: auto; height: auto; max-width: 96vw; max-height: 94svh; border-radius: 10px; background: #fff; }
  .zoom__fermer { position: absolute; top: 12px; right: 14px; width: 48px; height: 48px; border-radius: 50%; border: 0; background: #fff; color: var(--vert-fonce); font-size: 2rem; line-height: 1; cursor: pointer; }
  .fiche { display: grid; gap: 18px; align-items: start; }
  .fiche__image { padding: 12px; max-width: 560px; margin-inline: auto; }
  .fiche__image :global(img) { width: auto; max-width: 100%; height: auto; max-height: calc(100svh - 150px); margin-inline: auto; border-radius: 3px; box-shadow: 0 0 0 1px #c3c9cd, 0 0 0 3px #eef1f3, 0 0 0 4px #9aa2a8, 0 8px 14px -6px rgba(60, 40, 20, 0.35); }
  .fiche__prix { font-family: var(--titre); font-size: 2.6rem; color: var(--orange-fonce); margin: 0 0 4px; line-height: 1.1; }
  .fiche__petit { font-size: 0.98rem; }
  .fiche__panier { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .fiche__panier a { font-family: var(--titre); font-size: 1.2rem; }
  .fiche__nav { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-top: 34px; padding-top: 18px; border-top: 3px dashed var(--vert-pale); font-family: var(--titre); font-size: 1.3rem; }
  .fiche__nav a { display: grid; gap: 6px; text-decoration: none; justify-items: start; }
  .fiche__nav a[rel='next'] { justify-items: end; text-align: right; }
  .fiche__nav :global(img) { height: 84px; width: auto; border-radius: 8px 4px 8px 5px / 5px 8px 4px 8px; border: 2px solid var(--vert-fonce); }
  .suite { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 28px; }
  .suite :global(.carte) { margin: 0; }
  /* Mobile : le dessin, son titre, son prix et le bouton tiennent dans un seul écran. */
  @media (max-width: 859px) {
    .section--fiche { padding-top: 14px; }
    .section--fiche > .contenu > p { margin: 0 0 8px; }
    .fiche__image { padding: 8px; }
    .fiche__image :global(img) { max-height: max(240px, calc(100svh - 300px)); }
    .fiche__infos { display: grid; grid-template-columns: auto auto 1fr; align-items: center; column-gap: 16px; }
    .fiche__infos > :nth-child(1), .fiche__infos > :nth-child(2), .fiche__infos > :nth-child(4), .fiche__infos > :nth-child(6), .fiche__infos > :nth-child(7) { grid-column: 1 / -1; }
    .fiche__infos > :nth-child(3) { grid-column: 2; grid-row: 3; }
    .fiche__infos > :nth-child(5) { grid-column: 1; grid-row: 3; }
    .fiche__infos h1 { font-size: 1.9rem; margin: 0 0 4px; }
    .fiche__infos p { margin: 0 0 6px; }
    .fiche__infos .surtitre { margin: 0 0 0; }
    .fiche__prix { font-size: 2.2rem; margin: 0; }
    .fiche__panier a { display: none; } /* l'icône du panier est dans l'en-tête */
    .fiche__infos .bouton { padding: 10px 18px; font-size: 1.15rem; }
    .fiche__nav { margin-top: 18px; }
  }
  @media (min-width: 860px) {
      .fiche { grid-template-columns: 1.05fr 0.95fr; gap: 64px; }
    .fiche__image { position: sticky; top: 92px; margin: 0; }
    .suite { grid-template-columns: repeat(4, 1fr); }
  }
  .fiche__vendue { font-family: var(--titre); font-size: 1.5rem; color: var(--orange-fonce); }
  .fiche__envoi { font-size: 1rem; }
  .salon-bloc { max-width: 760px; margin-inline: auto; }
  .salon-bloc h2 { margin-top: 0; text-align: center; }
</style>
