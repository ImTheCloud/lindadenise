---
import Base from '../../layouts/Base.astro';
import Etang from '../Etang.astro';
import Feuilles from '../Feuilles.astro';
import Etapes from '../Etapes.astro';
import Apercu from '../Apercu.astro';
import { t, chemin, cheminDessin, dessins, parRubrique, RUBRIQUES, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.accueil;
const chemins = { fr: chemin('accueil', 'fr'), nl: chemin('accueil', 'nl') };
const trouve = (id: string) => dessins.find((x) => x.id === id)!;
const collage = ['trois-tournesols', 'l-ile-de-brehat', 'trio-de-chats-quebecois'].map(trouve);
const couvertures: Record<string, string> = { chats: 'tiroux-le-sage', nature: 'jacinthe-sauvage-dans-le-bois', fleurs: 'champ-de-tournesols', animaux: 'paon-indien' };
---
<Base lang={lang} chemins={chemins} mascotte="accueil">
  <section class="heros" data-mascotte="accueil">
    <Feuilles />
    <div class="contenu heros__grille">
      <div class="heros__texte">
        <p class="surtitre">{a.surtitre}</p>
        <h1><span class="mot-vert">Linda</span> <span class="mot-orange">Denise</span></h1>
        <p class="chapeau">{a.texte}</p>
        <div class="heros__actions">
          <a class="bouton" href={chemin('dessins', lang)}>{a.cta1}</a>
          <a class="bouton bouton--contour" href={chemin('apropos', lang)}>{a.cta2}</a>
        </div>
      </div>
      <div class="collage" aria-hidden="false">
        {collage.map((x, i) => (
          <a class={`collage__img collage__img--${i + 1}`} href={cheminDessin(x.id, lang)}>
            <Apercu id={x.id} alt={d.dessins.altDe(x.titre[lang])} largeur={x.largeur} hauteur={x.hauteur} chargement="eager" />
          </a>
        ))}
      </div>
    </div>
    <Etang />
  </section>

  <section class="section" data-mascotte="rubriques">
    <div class="contenu">
      <h2 class="centre apparait">{a.rubriquesTitre}</h2>
      <div class="rubriques">
        {RUBRIQUES.map((r, i) => {
          const c = trouve(couvertures[r]);
          return (
            <a class="rubrique apparait" style={`transition-delay:${i * 90}ms`} href={`${chemin('dessins', lang)}#${r}`}>
              <Apercu id={c.id} alt="" largeur={c.largeur} hauteur={c.hauteur} />
              <span class="rubrique__nom">{d.rubriques[r].nom}</span>
              <span class="rubrique__texte">{d.rubriques[r].texte}</span>
              <span class="rubrique__nombre">{a.nombre(parRubrique(r).length)}</span>
            </a>
          );
        })}
      </div>
      <p class="centre apparait rubriques__suite"><a class="bouton bouton--vert" href={chemin('dessins', lang)}>{a.tousLesDessins}</a></p>
    </div>
  </section>

  <section class="section section--orange" data-mascotte="offrir">
    <div class="contenu">
      <h2 class="centre apparait">{a.offrirTitre}</h2>
      <div class="offrir">
        {a.offrir.map((o, i) => (
          <article class="offre apparait" style={`transition-delay:${i * 100}ms`}>
            <span class="offre__pastille" aria-hidden="true">{['☮', '♥', '⌂'][i]}</span>
            <h3>{o.titre}</h3>
            <p>{o.texte}</p>
          </article>
        ))}
      </div>
      <div class="apparait etapes-bloc"><Etapes titre={d.dessins.etapesTitre} etapes={d.dessins.etapes} /></div>
      <div class="prix apparait cadre">
        <p class="prix__montant">{a.prix}</p>
        <h3 class="prix__titre">{a.prixPourquoiTitre}</h3>
        <ul class="prix__liste">{a.prixPourquoi.map((p) => <li>{p}</li>)}</ul>
        <a class="bouton" href={chemin('contact', lang)}>{a.prixCta}</a>
      </div>
    </div>
  </section>

  <section class="section" data-mascotte="impression">
    <div class="contenu impression">
      <div class="apparait impression__texte">
        <h2>{a.impressionTitre}</h2>
        <p class="chapeau">{a.impressionTexte}</p>
        <p>{a.impressionTexte2}</p>
      </div>
      <figure class="impression__video apparait cadre">
        <video controls playsinline preload="none" poster="/video/impressions.webp" width="478" height="850" aria-label={a.impressionAlt}>
          <source src="/video/impressions.mp4" type="video/mp4" />
          {a.impressionLecture}
        </video>
      </figure>
      <p class="impression__cta apparait"><a class="bouton bouton--vert" href={chemin('contact', lang)}>{a.impressionCta}</a></p>
    </div>
  </section>

  <section class="section" data-mascotte="apropos">
    <div class="contenu apropos">
      <div class="apropos__photo apparait">
        <img src="/images/linda.webp" width="640" height="640" alt={a.photoAlt} loading="lazy" decoding="async" />
      </div>
      <div class="apparait">
        <h2>{a.aproposTitre}</h2>
        <p class="chapeau">{a.aproposTexte}</p>
        <a class="bouton bouton--vert" href={chemin('apropos', lang)}>{a.aproposCta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .heros { position: relative; overflow: hidden; display: flex; align-items: center; min-height: calc(100svh - 68px); padding-top: clamp(28px, 5vw, 64px); padding-bottom: clamp(190px, 26vw, 330px); background: linear-gradient(#fff 55%, #f6fbf6); }
  .heros__grille { width: 100%; }
  .heros__grille { position: relative; z-index: 2; display: grid; gap: 28px; align-items: center; }
  .heros__texte h1 { font-size: clamp(3.8rem, 1.2rem + 9.5vw, 8.6rem); margin-bottom: 0.08em; line-height: 0.95; }
  .heros__texte .chapeau { font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem); }
  .heros__actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 26px; }
  .collage { position: relative; width: min(100%, 600px); aspect-ratio: 1 / 0.96; margin-inline: auto; }
  .collage__img { position: absolute; display: block; background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon); padding: 8px; box-shadow: var(--ombre); transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1); }
  .collage__img :global(img) { width: 100%; height: auto; border-radius: 10px; }
  .collage__img--1 { width: 47%; left: 0; top: 8%; transform: rotate(-7deg); animation: collage-flotte 7s ease-in-out infinite; }
  .collage__img--2 { width: 51%; right: 0; top: 0; transform: rotate(5deg); z-index: 2; animation: collage-flotte 8s ease-in-out -2s infinite; }
  .collage__img--3 { width: 49%; left: 26%; bottom: 0; transform: rotate(-2deg); z-index: 3; animation: collage-flotte 9s ease-in-out -4s infinite; }
  .collage__img:hover { transform: scale(1.06) rotate(0deg); z-index: 5; animation-play-state: paused; }
  @keyframes collage-flotte { 0%, 100% { translate: 0 0; } 50% { translate: 0 -10px; } }

  .rubriques { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 26px; margin-top: 34px; }
  .rubrique { display: flex; flex-direction: column; text-decoration: none; background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon); padding: 12px 12px 18px; box-shadow: var(--ombre); transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1); text-align: center; }
  .rubrique:nth-child(odd) { transform: rotate(-1deg); } .rubrique:nth-child(even) { transform: rotate(1deg); }
  .rubrique:hover { transform: translateY(-8px) rotate(0deg); }
  .rubrique :global(img) { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; object-position: top; border-radius: 14px 6px 14px 8px / 8px 14px 6px 14px; margin-bottom: 14px; }
  .rubrique__nom { font-family: var(--titre); font-size: 1.9rem; color: var(--orange-titre); line-height: 1.1; }
  .rubrique__texte { color: var(--encre-douce); font-size: 1rem; padding: 6px 10px 8px; }
  .rubrique__nombre { margin-top: auto; font-family: var(--titre); font-size: 1.2rem; color: var(--vert-fonce); }

  .rubriques__suite { margin-top: 34px; }
  .offrir { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 26px; margin: 34px 0; }
  .offre { background: #fff; border: var(--trait) solid var(--orange-fonce); border-radius: var(--rayon); padding: 22px 22px 8px; box-shadow: 0 6px 0 rgba(196, 94, 0, 0.18); }
  .offre h3 { color: var(--orange-fonce); }
  .offre__pastille { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--orange-fonce); color: #fff; font-size: 1.6rem; margin-bottom: 12px; }
  .etapes-bloc { max-width: 980px; margin: 8px auto 40px; }
  .prix { max-width: 560px; margin-inline: auto; text-align: center; padding: 26px 24px 30px; border-color: var(--orange-fonce); transform: rotate(-0.8deg); }
  .prix__titre { color: var(--orange-fonce); font-size: 1.5rem; margin: 14px 0 8px; }
  .prix__liste { list-style: none; margin: 0 0 22px; padding: 0; text-align: left; display: grid; gap: 8px; }
  .prix__liste li { position: relative; padding-left: 28px; line-height: 1.4; }
  .prix__liste li::before { content: '✓'; position: absolute; left: 0; top: 0; color: var(--orange-fonce); font-weight: 700; }
  .prix__montant { font-family: var(--titre); font-size: clamp(2.4rem, 6vw, 3.4rem); color: var(--orange-fonce); margin: 0; line-height: 1.1; }
  .impression { display: grid; gap: 32px; align-items: center; }
  .impression__cta { margin: 0; text-align: center; }
  .impression__video { width: min(78%, 320px); margin: 0 auto; padding: 10px; background: var(--vert-pale); transform: rotate(2deg); }
  .impression__video video { display: block; width: 100%; height: auto; aspect-ratio: 478 / 850; border-radius: 10px; background: #000; }
  .apropos { display: grid; gap: 36px; align-items: center; }
  .apropos__photo { width: min(78%, 360px); margin-inline: auto; background: var(--vert-pale); padding: 10px; border: var(--trait) solid var(--vert-fonce); border-radius: 56% 44% 52% 48% / 48% 54% 46% 52%; box-shadow: var(--ombre); transform: rotate(-3deg); }
  .apropos__photo img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 56% 44% 52% 48% / 48% 54% 46% 52%; }

  @media (max-width: 619px) {
    .rubriques { grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
    .rubrique { position: relative; justify-content: center; min-height: 152px; padding: 12px 14px 12px 154px; text-align: left; }
    .rubrique :global(img) { position: absolute; left: 12px; top: 50%; translate: 0 -50%; width: 130px; height: 130px; margin: 0; }
    .rubrique__nom { font-size: 1.6rem; }
    .rubrique__texte { padding: 2px 0; font-size: 0.95rem; line-height: 1.35; }
    .rubrique__nombre { margin-top: 2px; font-size: 1.05rem; }
  }
  @media (min-width: 960px) {
    .heros__grille { grid-template-columns: 0.95fr 1.05fr; gap: 48px; }
    .apropos { grid-template-columns: 0.8fr 1.2fr; gap: 64px; }
    .impression { grid-template-columns: 0.8fr 1.2fr; gap: 64px; }
    .impression__video { order: -1; }
  }
</style>
