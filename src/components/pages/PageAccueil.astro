---
import Base from '../../layouts/Base.astro';
import Bandeau from '../Bandeau.astro';
import CarteDessin from '../CarteDessin.astro';
import CarteToile from '../CarteToile.astro';
import Faq from '../Faq.astro';
import Etapes from '../Etapes.astro';
import Apercu from '../Apercu.astro';
import IconeLivraison from '../IconeLivraison.astro';
import Etang from '../Etang.astro';
import Feuilles from '../Feuilles.astro';
import { t, chemin, dessins, toiles, type Lang } from '../../i18n';
import { PRIX_TOILE } from '../../data/vente';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.accueil;
const tt = d.toiles;
const chemins = { fr: chemin('accueil', 'fr'), nl: chemin('accueil', 'nl') };
const trouve = (id: string) => dessins.find((x) => x.id === id)!;
const vitrineDessins = ['trois-tournesols', 'l-ile-de-brehat', 'time-et-rouroux-a-la-plage'].map(trouve);
const vitrineToiles = toiles.slice(0, 3);
const sources = (id: string, format: string) => [400, 800].map((l) => `/toiles/${id}-${l}.${format} ${l}w`).join(', ');
---
<Base lang={lang} chemins={chemins}>
  <section class="heros" data-accueil>
    <Feuilles />
    <div class="contenu heros__grille">
      <div class="heros__texte">
        <p class="surtitre">{a.surtitre}</p>
        <h1><span class="mot-vert">Linda</span> <span class="mot-orange">Denise</span></h1>
        <p class="chapeau heros__texte-court">{a.texte}</p>
        <div class="heros__actions">
          <a class="bouton bouton--vert" href={chemin('dessins', lang)}>{a.portes.dessinsCta}</a>
          <a class="bouton bouton--toiles" href={chemin('toiles', lang)}>{a.portes.toilesCta}</a>
        </div>
      </div>
      <div class="heros__video">
        <Bandeau lang={lang} nom={`toiles-${lang}`} description={a.impressionAlt} />
      </div>
    </div>
    <Etang />
  </section>

  <!-- Les deux mondes : mêmes blocs, couleurs inversées -->
  <section class="portes" aria-label={a.portesAria}>
    <Feuilles />
    <div class="contenu portes__grille">
    <a class="porte porte--dessins" href={chemin('dessins', lang)}>
      <span class="porte__vitrine" aria-hidden="true">
        {vitrineDessins.map((x, i) => (
          <span class={`porte__image porte__image--${i + 1}`}>
            <Apercu id={x.id} alt="" largeur={x.largeur} hauteur={x.hauteur} />
          </span>
        ))}
      </span>
      <span class="porte__texte">
        <span class="porte__nombre">{a.nombre(dessins.length)}</span>
        <span class="porte__nom">{d.nav.dessins}</span>
        <span class="porte__phrase">{a.portes.dessins(d.dessins.prix)}</span>
        <span class="porte__livraison"><IconeLivraison genre="dessin" />{d.livraison.dessin}</span>
        <span class="porte__cta">{a.portes.dessinsCta}</span>
      </span>
    </a>
    <a class="porte porte--toiles" href={chemin('toiles', lang)}>
      <span class="porte__vitrine" aria-hidden="true">
        {vitrineToiles.map((x, i) => (
          <span class={`porte__image porte__image--${i + 1}`}>
            <picture>
              <source type="image/avif" srcset={sources(x.id, 'avif')} sizes="(min-width: 900px) 14vw, 28vw" />
              <img src={`/toiles/${x.id}-400.webp`} width="400" height="566" alt="" loading="lazy" decoding="async" />
            </picture>
          </span>
        ))}
      </span>
      <span class="porte__texte">
        <span class="porte__nombre">{a.nombreToiles(toiles.length)}</span>
        <span class="porte__nom">{d.nav.toiles}</span>
        <span class="porte__phrase">{a.portes.toiles(tt.prix(PRIX_TOILE))}</span>
        <span class="porte__livraison"><IconeLivraison genre="toile" />{d.livraison.toile}</span>
        <span class="porte__cta">{a.portes.toilesCta}</span>
      </span>
    </a>
    </div>
  </section>

  <section class="section rangee">
    <div class="contenu">
      <header class="rangee__tete">
        <h2>{a.nouveautesDessins}</h2>
        <a class="rangee__lien" href={chemin('dessins', lang)}>{a.toutVoir}</a>
      </header>
      <div class="grille-accueil">
        {dessins.slice(0, 4).map((x, i) => <CarteDessin dessin={x} lang={lang} priorite={i < 2} />)}
      </div>
      <div class="rangee__etapes"><Etapes titre={d.dessins.etapesTitre} etapes={d.dessins.etapes} /></div>
    </div>
  </section>

  <section class="section rangee rangee--toiles" data-monde="toiles">
    <div class="contenu">
      <header class="rangee__tete">
        <h2>{a.nouveautesToiles}</h2>
        <a class="rangee__lien" href={chemin('toiles', lang)}>{a.toutVoir}</a>
      </header>
      <div class="grille-accueil">
        {toiles.slice(0, 4).map((x) => <CarteToile toile={x} lang={lang} />)}
      </div>
      <div class="rangee__etapes"><Etapes titre={tt.commanderTitre} etapes={tt.etapes} /></div>
    </div>
  </section>

  <section class="section">
    <div class="contenu apropos">
      <div class="apropos__photo apparait">
        <img src="/images/linda.webp" width="640" height="640" alt={a.photoAlt} loading="lazy" decoding="async" />
      </div>
      <div class="apparait">
        <h2>{a.aproposTitre}</h2>
        <p class="chapeau">{a.aproposTexte}</p>
        <a class="bouton bouton--vert" href={chemin('apropos', lang)}>{a.aproposCta}</a>
      </div>
    </div>
  </section>

  <Faq titre={d.faq.titre} questions={d.faq.questions} />
</Base>

<style>
  /* Premier écran : titre, vidéo et trois dessins, avec l'étang tout en bas ; les deux portes viennent ensuite */
  .heros { position: relative; overflow: hidden; display: flex; align-items: center; min-height: calc(100svh - 68px); padding-top: clamp(16px, 3vw, 40px); padding-bottom: clamp(130px, 18vw, 240px); background: linear-gradient(#fff 55%, #f6fbf6); }
  .heros__grille { position: relative; z-index: 1; width: 100%; display: grid; gap: 28px; align-items: center; }
  .heros__texte h1 { font-size: clamp(3.4rem, 1.4rem + 7vw, 7rem); margin-bottom: 0.1em; line-height: 0.95; }
  .heros__texte-court { margin: 0 0 4px; max-width: 34ch; font-size: clamp(1.05rem, 1rem + 0.3vw, 1.3rem); }
  .heros__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; max-width: 420px; }
  .heros__actions :global(.bouton) { justify-content: center; padding: 0.65em 0.6em; font-size: 1.15rem; }
  .bouton--toiles { background: var(--monde-toiles); border-color: #8f4300; box-shadow: 0 5px 0 #7a3a00; }
  .bouton--toiles:hover { box-shadow: 0 7px 0 #7a3a00; }
  /* Grand écran : titre à gauche, grande vidéo à droite : toute la largeur sert */
  @media (min-width: 1100px) {
    .heros__actions { display: flex; flex-wrap: wrap; gap: 14px; max-width: none; }
    .heros__actions :global(.bouton) { padding: 0.7em 1.3em; font-size: 1.35rem; }
    .heros__grille { max-width: 1300px; grid-template-columns: 0.74fr 1.26fr; gap: clamp(24px, 3vw, 56px); }
    .heros__texte h1 { font-size: clamp(3.4rem, 0.6rem + 4.6vw, 5.8rem); }
  }

  /* Deux grands blocs dessinés : vert pour les dessins, brun pour les toiles */
  .portes { position: relative; overflow: hidden; padding-block: clamp(16px, 3vw, 32px) clamp(24px, 4vw, 44px); background: var(--fond); }
  .portes__grille { position: relative; z-index: 1; display: grid; gap: clamp(18px, 3vw, 32px); }
  .porte { --p: var(--monde-dessins); --p-pale: #e3f1e3; position: relative; display: grid; grid-template-rows: auto 1fr; overflow: hidden; color: #fff; text-decoration: none; background: var(--p); border: var(--trait) solid var(--p); border-radius: var(--rayon); box-shadow: 0 8px 0 rgba(0, 0, 0, 0.14); transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1); }
  .porte--toiles { --p: var(--monde-toiles); --p-pale: #ffe0b8; }
  .porte:hover { color: #fff; transform: translateY(-6px) rotate(-0.6deg); }
  .porte__vitrine { position: relative; overflow: hidden; height: clamp(170px, 24vw, 230px); background: var(--p-pale); }
  .porte__image { position: absolute; bottom: -10%; width: 30%; max-width: 220px; aspect-ratio: 5 / 7; overflow: hidden; padding: 5px; background: #fff; border: 3px solid var(--p); border-radius: 12px 6px 12px 8px / 8px 12px 6px 12px; box-shadow: 0 10px 0 rgba(0, 0, 0, 0.12); transition: transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1); }
  .porte__image :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 8px 4px 8px 5px; }
  .porte--toiles .porte__image { background: #e9ecee; border-radius: 4px; }
  .porte--toiles .porte__image :global(img) { border-radius: 2px; }
  .porte__image--1 { left: 8%; transform: rotate(-6deg); }
  .porte__image--2 { left: 34%; transform: translateY(-8%) rotate(1deg); z-index: 2; }
  .porte__image--3 { left: 60%; transform: rotate(6deg); }
  .porte:hover .porte__image--1 { transform: rotate(-9deg) translateY(-3%); }
  .porte:hover .porte__image--2 { transform: translateY(-12%) rotate(-1deg); }
  .porte:hover .porte__image--3 { transform: rotate(9deg) translateY(-3%); }
  .porte__texte { position: relative; display: grid; gap: 8px; align-content: start; justify-items: start; padding: clamp(14px, 2vw, 24px); }
  .porte__nombre { font-family: var(--titre); font-size: 1.3rem; }
  .porte__nom { font-family: var(--titre); font-size: clamp(2.6rem, 1.4rem + 3.6vw, 4.2rem); line-height: 0.95; }
  .porte__phrase { max-width: 34ch; font-size: 1.1rem; line-height: 1.45; }
  .porte__livraison { display: inline-flex; align-items: center; gap: 8px; font-size: 1rem; font-weight: 600; }
  .porte__cta { display: inline-flex; align-items: center; min-height: 48px; margin-top: 6px; padding: 0 1.3em; font-family: var(--titre); font-size: 1.35rem; color: var(--p); background: #fff; border-radius: var(--rayon-petit); box-shadow: 0 4px 0 rgba(0, 0, 0, 0.2); }

  /* Une rangée par monde : mêmes éléments, mêmes places */
  .rangee { background: var(--fond); }
  .rangee__tete { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: clamp(10px, 2vw, 18px); }
  .rangee__tete h2 { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); margin: 0; }
  .rangee__lien { flex: none; font-family: var(--titre); font-size: 1.35rem; color: var(--vert-fonce); text-underline-offset: 5px; }
  .grille-accueil { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
  .rangee__etapes { margin-top: clamp(20px, 3vw, 36px); padding-top: clamp(16px, 2.5vw, 26px); border-top: 2px dashed var(--vert-pale); }
  .rangee--toiles { padding-top: clamp(28px, 4.5vw, 56px); }

  .apropos { display: grid; gap: 20px; align-items: center; }
  .apropos__photo { width: min(78%, 360px); margin-inline: auto; background: var(--vert-pale); padding: 10px; border: var(--trait) solid var(--vert-fonce); border-radius: 56% 44% 52% 48% / 48% 54% 46% 52%; box-shadow: var(--ombre); transform: rotate(-3deg); }
  .apropos__photo img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 56% 44% 52% 48% / 48% 54% 46% 52%; }

  @media (min-width: 700px) { .grille-accueil { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px 18px; } }
  @media (min-width: 900px) {
    .portes__grille { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 960px) { .apropos { grid-template-columns: 0.8fr 1.2fr; gap: 40px; } }
</style>
