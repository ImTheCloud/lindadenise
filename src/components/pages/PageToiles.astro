---
import Base from '../../layouts/Base.astro';
import Galerie from '../Galerie.astro';
import CarteToile from '../CarteToile.astro';
import Etapes from '../Etapes.astro';
import Video from '../Video.astro';
import Bandeau from '../Bandeau.astro';
import { t, chemin, toiles, RUBRIQUES, type Lang } from '../../i18n';
import { PRIX_TOILE, FRAIS_ENVOI, ENVOI_OFFERT_DES, TOILES_ACHETEES, calculLot } from '../../data/vente';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const tt = d.toiles;
const chemins = { fr: chemin('toiles', 'fr'), nl: chemin('toiles', 'nl') };
const contact = chemin('contact', lang);
const rubriques = RUBRIQUES.map((r) => ({ code: r, nom: d.rubriques[r].court, nombre: toiles.filter((x) => x.rubrique === r).length })).filter((r) => r.nombre > 0);
---
<Base lang={lang} monde="toiles" titre={tt.titre} description={tt.meta} chemins={chemins} image={`/toiles/${toiles[0].id}-800.jpg`}>
  <Bandeau lang={lang} nom={`toiles-${lang}`} description={tt.videoFilmAlt} />

  <Galerie titre={d.nav.toiles} tous={d.dessins.tous} groupe={d.dessins.rubrique} rubriques={rubriques} total={toiles.length}>
    {toiles.map((x, i) => <CarteToile toile={x} lang={lang} priorite={i < 4} />)}
  </Galerie>

  <section class="section videos-bande">
    <div class="contenu">
      <h2 class="apparait">{tt.videoVraies}</h2>
      <figure class="vraies apparait">
        <Video lang={lang} nom="vraies-toiles" largeur={478} hauteur={850} description={tt.videoVraiesAlt} son />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="contenu infos">
      <article class="info cadre apparait">
        <h2>{tt.qualiteTitre}</h2>
        <ul class="coches">{tt.qualite.map((q) => <li>{q}</li>)}</ul>
      </article>
      <article class="info info--prix cadre apparait">
        <h2>{tt.prixTitre}</h2>
        <p class="info__montant">{tt.prix(PRIX_TOILE)}</p>
        <p>{tt.envoi(FRAIS_ENVOI)}</p>
        <h3>{tt.lotTitre}</h3>
        <ul class="coches">
          <li>{tt.lot} : {tt.exemple(TOILES_ACHETEES + 1, calculLot(TOILES_ACHETEES + 1).total)}</li>
          <li>{tt.envoiOffert(ENVOI_OFFERT_DES)}</li>
        </ul>
        <p class="info__note">{tt.livraison} {tt.paiement}</p>
        <p class="info__note"><a href={chemin('conditionsToiles', lang)}>{tt.conditions}</a></p>
      </article>
    </div>
  </section>

  <section class="section section--orange">
    <div class="contenu etapes-toiles apparait"><Etapes titre={tt.commanderTitre} etapes={tt.etapes} /></div>
  </section>

  <section class="section">
    <div class="contenu expo apparait">
      <h2>{tt.expoTitre}</h2>
      <p class="histoire">{tt.histoire}</p>
      <p class="chapeau">{tt.expoTexte}</p>
      <p>{tt.expoTexte2}</p>
      <p class="expo__signature">Linda</p>
      <a class="bouton bouton--vert" href={`${contact}?sujet=exposition`}>{tt.expoCta}</a>
    </div>
  </section>
</Base>

<style>
  .infos { display: grid; gap: 28px; }
  .info { padding: 8px 24px 18px; }
  .info h2 { margin-top: 0.5em; }
  .info h3 { font-size: 1.4rem; margin-top: 1em; }
  .info--prix { border-color: var(--orange-fonce); }
  .info__montant { font-family: var(--titre); font-size: 2.6rem; line-height: 1.1; color: var(--orange-fonce); margin: 0; }
  .info__note { margin: 0; color: var(--encre-douce); }
  .coches { list-style: none; margin: 0 0 14px; padding: 0; display: grid; gap: 8px; }
  .coches li { position: relative; padding-left: 28px; line-height: 1.4; }
  .coches li::before { content: '✓'; position: absolute; left: 0; color: var(--orange-fonce); font-weight: 700; }
  .etapes-toiles { max-width: 980px; }
  .videos-bande { background: var(--vert-creme); text-align: center; }
  .videos-bande h2 { margin-bottom: 24px; }
  .vraies { width: min(100%, 300px); margin: 0 auto; }
  .expo { max-width: 760px; text-align: center; }
  .expo .chapeau { margin-inline: auto; }
  .expo__signature { font-family: var(--titre); font-size: 1.8rem; color: var(--orange-titre); margin: -6px 0 18px; }
  @media (min-width: 900px) {
    .infos { grid-template-columns: 1fr 1fr; }
  }
</style>
