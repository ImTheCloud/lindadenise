---
import Base from '../../layouts/Base.astro';
import Galerie from '../Galerie.astro';
import CarteToile from '../CarteToile.astro';
import Video from '../Video.astro';
import { t, chemin, toiles, RUBRIQUES, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const tt = d.toiles;
const onglets = { dessin: { href: chemin('dessins', lang), nom: d.nav.dessins }, toile: { href: chemin('toiles', lang), nom: d.nav.toiles } };
const chemins = { fr: chemin('toiles', 'fr'), nl: chemin('toiles', 'nl') };
const contact = chemin('contact', lang);
const rubriques = RUBRIQUES.map((r) => ({ code: r, nom: d.rubriques[r].court, nombre: toiles.filter((x) => x.rubrique === r).length })).filter((r) => r.nombre > 0);
---
<Base lang={lang} monde="toiles" titre={tt.titre} description={tt.meta} chemins={chemins} image={`/toiles/${toiles[0].id}-800.jpg`}>
  <Galerie titre={d.nav.toiles} tous={d.dessins.tous} groupe={d.dessins.rubrique} rubriques={rubriques} total={toiles.length} genre="toile" phrase={tt.phrase} onglets={onglets} bonus={tt.bonus}>
    {rubriques.map((r, k) => (
      <section class="rubrique-bloc" data-bloc={r.code}>
        <h2 class="rubrique-bloc__titre">{d.rubriques[r.code].nom} <span>({r.nombre})</span></h2>
        <div class="grille">
          {toiles.filter((x) => x.rubrique === r.code).map((x, i) => <CarteToile toile={x} lang={lang} priorite={k === 0 && i < 4} />)}
        </div>
      </section>
    ))}
  </Galerie>

  <section class="section videos-bande">
    <div class="contenu">
      <h2 class="centre apparait">{tt.videoVraies}</h2>
      <figure class="vraies apparait">
        <Video lang={lang} nom="vraies-toiles" largeur={478} hauteur={850} description={tt.videoVraiesAlt} />
      </figure>
    </div>
  </section>


  <section class="section">
    <div class="contenu expo apparait">
      <h2>{tt.expoTitre}</h2>
      <p class="histoire">{tt.histoire}</p>
      <p class="chapeau">{tt.expoTexte}</p>
      <p>{tt.expoTexte2}</p>
      <p class="expo__signature">Linda</p>
      <a class="bouton bouton--vert" href={`${contact}?sujet=exposition`}>{tt.expoCta}</a>
    </div>
  </section>
</Base>

<style>
  .videos-bande { background: var(--vert-creme); text-align: center; }
  .videos-bande h2 { margin: 0 0 24px; }
  .vraies { width: min(100%, 300px); margin: 0 auto; padding: 10px; background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon); box-shadow: var(--ombre); }
  .expo { max-width: 760px; text-align: center; }
  .expo .chapeau { margin-inline: auto; }
  .expo__signature { font-family: var(--titre); font-size: 1.8rem; color: var(--orange-titre); margin: -6px 0 18px; }
</style>
