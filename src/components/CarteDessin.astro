---
import Apercu from './Apercu.astro';
import { cheminDessin, t, type Dessin, type Lang } from '../i18n';
interface Props { dessin: Dessin; lang: Lang; priorite?: boolean }
const { dessin, lang, priorite = false } = Astro.props;
const titre = dessin.titre[lang];
const p = t(lang).panier;
---
<article class="carte" data-rubrique={dessin.rubrique}>
  <a class="carte__lien" href={cheminDessin(dessin.id, lang)}>
    <Apercu id={dessin.id} alt={`${titre} – Linda Denise`} largeur={dessin.largeur} hauteur={dessin.hauteur} chargement={priorite ? 'eager' : 'lazy'} />
    <span class="carte__titre">{titre}</span>
  </a>
  <button type="button" class="carte__panier" aria-pressed="false" aria-label={p.ajouterAria.replace('{t}', titre)} data-panier={`dessin:${dessin.id}`} data-titre={titre} data-ajouter={p.ajouter} data-dedans={p.dedans} data-aria-ajouter={p.ajouterAria} data-aria-dedans={p.dedansAria}>
    <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><path d="M3 7h4l3.2 13.5h13.6L27 11H8.6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="25.5" r="2.5" fill="currentColor" /><circle cx="22" cy="25.5" r="2.5" fill="currentColor" /></svg>
    <span data-panier-texte>{p.ajouter}</span>
  </button>
</article>
<style>
  .carte { background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon); padding: 10px 10px 10px; box-shadow: var(--ombre); transition: transform 0.25s cubic-bezier(0.3, 1.4, 0.5, 1), box-shadow 0.25s; break-inside: avoid; margin-bottom: 22px; }
  .carte__lien { display: block; text-decoration: none; }
  .carte__lien :global(img) { width: 100%; height: auto; border-radius: 12px 6px 12px 8px / 8px 12px 6px 12px; background: var(--vert-creme); }
  .carte__titre { display: block; font-family: var(--titre); font-size: 1.35rem; line-height: 1.15; color: var(--vert-fonce); padding: 10px 6px 8px; text-align: center; }
  .carte:hover, .carte:focus-within { transform: translateY(-6px) rotate(-1.4deg); box-shadow: 0 12px 0 rgba(43, 110, 58, 0.14); }
  .carte:hover .carte__titre { color: var(--orange-fonce); }
  .carte[hidden] { display: none; }
  .carte__panier { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 7px 10px; font-family: var(--titre); font-size: 1.1rem; line-height: 1.1; cursor: pointer; color: var(--vert-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); transition: background-color 0.15s, color 0.15s; }
  .carte__panier:hover { background: var(--orange-creme); color: var(--orange-fonce); border-color: var(--orange-fonce); }
  .carte__panier[aria-pressed='true'] { background: var(--vert-fonce); color: #fff; }
  @media (max-width: 619px) {
    .carte__panier { font-size: 0.9rem; padding: 6px 4px; white-space: nowrap; }
    .carte__panier svg { display: none; }
  }
</style>
