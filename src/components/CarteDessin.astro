---
import Apercu from './Apercu.astro';
import { cheminDessin, t, type Dessin, type Lang } from '../i18n';
interface Props { dessin: Dessin; lang: Lang; priorite?: boolean }
const { dessin, lang, priorite = false } = Astro.props;
const titre = dessin.titre[lang];
const p = t(lang).panier;
---
<article class="carte" data-rubrique={dessin.rubrique}>
  <a class="carte__lien" href={cheminDessin(dessin.id, lang)}>
    <Apercu id={dessin.id} alt={`${titre} – Linda Denise`} largeur={dessin.largeur} hauteur={dessin.hauteur} chargement={priorite ? 'eager' : 'lazy'} />
    <span class="carte__titre">{titre}</span>
  </a>
  <button type="button" class="carte__panier" aria-pressed="false" aria-label={p.ajouterAria.replace('{t}', titre)} data-panier={`dessin:${dessin.id}`} data-titre={titre} data-ajouter={p.ajouter} data-dedans={p.dedans} data-aria-ajouter={p.ajouterAria} data-aria-dedans={p.dedansAria}>
    <svg viewBox="0 0 32 32" width="20" height="20" aria-hidden="true"><path d="M3 7h4l3.2 13.5h13.6L27 11H8.6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="25.5" r="2.5" fill="currentColor" /><circle cx="22" cy="25.5" r="2.5" fill="currentColor" /></svg>
    <span data-panier-texte>{p.ajouter}</span>
  </button>
</article>
