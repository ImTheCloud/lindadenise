---
import { t, chemin, autreLangue, type Lang } from '../i18n';
interface Props { lang: Lang; chemins: { fr: string; nl: string } }
const { lang, chemins } = Astro.props;
const d = t(lang);
const autre = autreLangue(lang);
const liens = [
  { cle: 'dessins', href: chemin('dessins', lang), nom: d.nav.dessins },
  { cle: 'toiles', href: chemin('toiles', lang), nom: d.nav.toiles },
  { cle: 'apropos', href: chemin('apropos', lang), nom: d.nav.apropos },
  { cle: 'jeu', href: chemin('jeu', lang), nom: d.nav.jouer },
  { cle: 'contact', href: chemin('contact', lang), nom: d.nav.contact },
] as const;
const actuel = Astro.url.pathname;
---
<header class="entete">
  <div class="contenu entete__ligne">
    <a class="marque" href={chemin('accueil', lang)} aria-label={`Linda Denise – ${d.nav.accueil}`}>
      <img src="/favicon.svg" alt="" width="52" height="52" />
      <span class="marque__nom">Linda <b>Denise</b></span>
    </a>
    <div class="entete__droite">
      <div class="menu" id="menu-principal" data-menu>
        <nav aria-label="Principal">
          <ul>
            {liens.map((l) => (
              <li><a href={l.href} data-monde-lien={l.cle === 'dessins' || l.cle === 'toiles' ? l.cle : undefined} aria-current={actuel.startsWith(l.href) ? 'page' : undefined}>{l.nom}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <a class="panier-lien" href={chemin('panier', lang)} aria-label={d.panier.lien} title={d.panier.lien}>
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path d="M3 7h4l3.2 13.5h13.6L27 11H8.6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="25.5" r="2.3" fill="currentColor" /><circle cx="22" cy="25.5" r="2.3" fill="currentColor" /></svg>
        <span class="panier-lien__n" data-panier-nombre hidden></span>
      </a>
      <a class="langue" href={chemins[autre]} hreflang={autre} lang={autre} title={d.langues[autre]}>
        <span class:list={[lang === 'fr' && 'actif']}>FR</span><span class:list={[lang === 'nl' && 'actif']}>NL</span>
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-principal" data-burger>
        <span class="sr-only">{d.nav.menu}</span><i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>
<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  bouton?.addEventListener('click', () => {
    const ouvert = bouton.getAttribute('aria-expanded') === 'true';
    bouton.setAttribute('aria-expanded', String(!ouvert));
    menu?.classList.toggle('ouvert', !ouvert);
  });
</script>
<style>
  /* L'en-tête garde ses couleurs par défaut sur toutes les pages, aussi dans le monde des toiles */
  .entete { --vert: #3e9a47; --vert-fonce: #2b6e3a; --vert-creme: #fff; --vert-pale: #dff0df; --orange-fonce: #cf6408; --orange-titre: #cf6408; --orange-creme: #fff; --encre: #2b3b2b; --encre-douce: #4d5d4d; --accent: #2b6e3a; --fond: #fff; position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(8px); border-bottom: var(--trait) solid var(--vert-pale); }
  .entete__ligne { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
  .marque { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .marque img { transition: transform 0.4s; }
  .marque:hover img { transform: rotate(-12deg) scale(1.06); }
  .marque__nom { font-family: var(--titre); font-size: 1.9rem; color: var(--vert-fonce); line-height: 1; }
  .marque__nom b { font-weight: 400; color: var(--orange-titre); }
  .entete__droite { display: flex; align-items: center; gap: 28px; }
  .menu { display: flex; align-items: center; }
  .menu ul { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .menu a:not(.langue) { font-family: var(--titre); font-size: 1.45rem; text-decoration: none; color: var(--vert-fonce); padding: 6px 14px; border-radius: var(--rayon-petit); display: block; }
  .menu a:not(.langue):hover, .menu a[aria-current='page'] { background: var(--orange-creme); color: var(--orange-fonce); }
  /* Les deux mondes gardent leur couleur sur toutes les pages : point vert pour les dessins, point brun pour les toiles */
  .menu a[data-monde-lien] { display: flex; align-items: center; gap: 8px; }
  .menu a[data-monde-lien]::before { content: ''; width: 11px; height: 11px; border-radius: 50%; background: var(--monde-dessins); }
  .menu a[data-monde-lien='toiles']::before { background: var(--monde-toiles); }
  .langue { display: inline-flex; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); overflow: hidden; text-decoration: none; font-family: var(--titre); font-size: 1.15rem; }
  .langue span { padding: 3px 11px; color: var(--vert-fonce); }
  .langue .actif { background: var(--accent); color: #fff; }
  .panier-lien { position: relative; display: grid; place-items: center; width: 48px; height: 48px; color: var(--vert-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); text-decoration: none; }
  .panier-lien:hover { background: var(--orange-creme); color: var(--orange-fonce); }
  .panier-lien__n { position: absolute; top: -9px; right: -9px; min-width: 24px; height: 24px; padding: 0 6px; display: grid; place-items: center; font-family: var(--titre); font-size: 1rem; line-height: 1; color: #fff; background: var(--orange-fonce); border: 2px solid #fff; border-radius: 12px; }
  .panier-lien__n[hidden] { display: none; }
  .burger { display: none; width: 52px; height: 48px; border: var(--trait) solid var(--vert-fonce); border-radius: var(--rayon-petit); background: #fff; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
  .burger i { display: block; width: 24px; height: 3px; background: var(--vert-fonce); border-radius: 3px; transition: transform 0.25s, opacity 0.25s; }
  .burger[aria-expanded='true'] i:nth-of-type(1) { transform: translateY(8px) rotate(45deg); }
  .burger[aria-expanded='true'] i:nth-of-type(2) { opacity: 0; }
  .burger[aria-expanded='true'] i:nth-of-type(3) { transform: translateY(-8px) rotate(-45deg); }
  @media (max-width: 820px) {
    .entete__droite { gap: 10px; }
    .burger { display: flex; width: 48px; }
    .menu { position: absolute; left: 0; right: 0; top: 100%; background: #fff; flex-direction: column; align-items: stretch; gap: 14px; padding: 18px var(--gouttiere) 24px; border-bottom: var(--trait) solid var(--vert-pale); display: none; }
    .menu.ouvert { display: flex; }
    .menu ul { flex-direction: column; }
    .menu a:not(.langue) { font-size: 1.7rem; padding: 10px 14px; }
    .marque { gap: 8px; }
    .marque__nom { font-size: 1.6rem; white-space: nowrap; }
    .marque img { width: 44px; height: 44px; }
    .langue span { padding: 3px 9px; }
  }
  /* petits téléphones : le nom, le panier, la langue et le menu tiennent sur une ligne sans se chevaucher */
  @media (max-width: 430px) { .marque { flex-shrink: 0; gap: 6px; } .marque__nom { font-size: 1.15rem; } .marque img { width: 36px; height: 36px; } .entete__droite { gap: 6px; } .burger, .panier-lien { width: 42px; height: 42px; } .langue span { padding: 3px 6px; } }
  @media (max-width: 349px) { .marque__nom { display: none; } }
</style>
