---
// Petite icône de la façon de recevoir : une enveloppe (fichier par e-mail) ou un colis (toile livrée par bpost).
interface Props { genre: 'dessin' | 'toile'; taille?: number }
const { genre, taille = 18 } = Astro.props;
---
{genre === 'dessin' ? (
  <svg viewBox="0 0 32 32" width={taille} height={taille} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="7" width="25" height="18" rx="3" /><path d="M5 10l11 8 11-8" /></svg>
) : (
  <svg viewBox="0 0 32 32" width={taille} height={taille} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10l12-6 12 6v13L16 29 4 23z" /><path d="M4 10l12 6 12-6M16 16v13" /></svg>
)}
