---
// Grand tilleul dessiné (page de jeu) : couronne feuillue en trois tons (dessous sombre, reflets du haut), petites feuilles
// en cœur, feuilles qui pendent sous la couronne et fleurs de tilleul ; branches et tronc qui descend jusqu'à l'étang.
// Même manière que Tilleul : toutes les boules de la couronne sont tracées d'un seul trait épais, puis remplies par-dessus
// (il ne reste que le tour de l'ensemble). Décor, ignoré par les lecteurs d'écran.
// La couronne garde ses proportions ; le bas du tronc (arbre__tronc) s'allonge jusqu'à l'étang.
import { FEUILLE, NERVURES } from './tilleul/formes';

// petit hasard reproductible : l'arbre est le même à chaque construction du site
let graine = 11;
const hasard = () => { graine = (graine * 16807) % 2147483647; return graine / 2147483647; };
const rond = (n: number) => Math.round(n * 10) / 10;

// couronne dans un cadre de 1000 × 760 ; le tronc sort du bas en x = 640
const CX = 500, CY = 360, RX = 370, RY = 230;
// boules du bord, plus petites et un peu remontées en bas (le dessous d'un tilleul est plus plat)
const lobes = Array.from({ length: 26 }, (_, k) => {
  const a = (k / 26) * Math.PI * 2, bas = Math.max(0, Math.sin(a));
  return { x: rond(CX + RX * Math.cos(a)), y: rond(CY + RY * Math.sin(a) - 40 * bas), r: rond((104 + 24 * Math.sin(k * 2.3)) * (1 - 0.32 * bas)), a };
});
const boule = (x: number, y: number, r: number) => `M${rond(x - r)},${y}a${r},${r} 0 1 0 ${rond(2 * r)},0a${r},${r} 0 1 0 ${rond(-2 * r)},0Z`;
const masse = (dx = 0, dy = 0) => lobes.map((l) => boule(l.x + dx, l.y + dy, l.r)).join('') + `M${CX - RX + dx},${CY + dy}a${RX},${RY + 20} 0 1 0 ${2 * RX},0a${RX},${RY + 20} 0 1 0 ${-2 * RX},0Z`;
// reflet : une bande plus claire le long du bord du haut, faite des mêmes boules un peu rentrées (elles se fondent)
const reflet = lobes.filter((l) => Math.sin(l.a) < -0.15 && Math.cos(l.a) < 0.75).map((l) => boule(rond(l.x + 0.16 * l.r), rond(l.y + 0.2 * l.r), rond(l.r * 0.8))).join('');
// petites feuilles en cœur sur toute la couronne : claires en haut, sombres en bas
const petites: { x: number; y: number; a: number; k: number; c: string }[] = [];
while (petites.length < 54) {
  const x = CX + (hasard() * 2 - 1) * RX * 0.92, y = CY + (hasard() * 2 - 1) * RY * 0.95;
  if (((x - CX) / (RX * 0.92)) ** 2 + ((y - CY) / (RY * 0.95)) ** 2 > 1) continue;
  const clair = y < CY - 20 ? hasard() < 0.85 : hasard() < 0.25;
  petites.push({ x: rond(x), y: rond(y), a: Math.round(hasard() * 360), k: rond(0.2 + hasard() * 0.12), c: clair ? (hasard() < 0.5 ? '#6CBF6F' : '#58B05E') : hasard() < 0.5 ? '#2E7A3B' : '#357F40' });
}
// feuilles qui pendent sous la couronne (c'est de là que tombent celles du jeu)
const pendues = lobes.filter((l) => Math.sin(l.a) > 0.3).map((l) => ({ x: rond(l.x + (hasard() - 0.5) * 30), y: rond(l.y + l.r * 0.82), a: Math.round(180 + (hasard() - 0.5) * 60) }));
// fleurs de tilleul : une bractée pâle et quelques boutons crème
const fleurs = [[300, 470], [420, 540], [560, 520], [690, 470], [790, 420], [210, 400], [470, 300], [640, 260], [350, 220]];
// branches, sous le feuillage (on les voit entre les boules du bas)
const branches = ['M640,760 C640,690 626,640 604,560', 'M632,650 C560,590 452,566 352,500', 'M648,630 C700,566 760,532 806,470', 'M612,590 C584,506 566,430 520,362', 'M598,600 C520,560 420,520 250,470'];
---
<div class="arbre" aria-hidden="true">
  <svg class="arbre__tronc" viewBox="0 0 100 300" preserveAspectRatio="none">
    <path d="M0,-4 L0,300 L100,300 L100,-4 Z" fill="#9C5B2C" />
    <path d="M0,-4 L0,300 M100,300 L100,-4" fill="none" stroke="#6B3A17" stroke-width="5" vector-effect="non-scaling-stroke" />
  </svg>
  <svg class="arbre__couronne" viewBox="0 0 1000 760" data-couronne>
    <g fill="none" stroke-linecap="round">
      {branches.map((d, i) => <path d={d} stroke="#6B3A17" stroke-width={i === 0 ? 92 : 34 - i * 3} />)}
      {branches.map((d, i) => <path d={d} stroke="#9C5B2C" stroke-width={i === 0 ? 82 : 26 - i * 3} />)}
    </g>
    <path d={masse() + masse(10, 30)} fill="#245E31" stroke="#245E31" stroke-width="14" stroke-linejoin="round" />
    <path d={masse(10, 30)} fill="#2E7A3B" />
    <path d={masse()} fill="#3E9A47" />
    <path d={reflet} fill="#48A34F" />
    {petites.map((p) => <path d={FEUILLE} fill={p.c} transform={`translate(${p.x},${p.y}) rotate(${p.a}) scale(${p.k}) translate(-50,-50)`} />)}
    {fleurs.map(([x, y]) => (
      <g transform={`translate(${x},${y})`}>
        <path d="M0,0 C10,8 14,30 6,44 C-2,30 -6,12 0,0 Z" fill="#E3EFA0" stroke="#9BB05A" stroke-width="2" />
        <circle cx="-8" cy="6" r="7" fill="#FFF3C4" stroke="#E2C66B" stroke-width="1.5" /><circle cx="6" cy="10" r="7" fill="#FFF3C4" stroke="#E2C66B" stroke-width="1.5" /><circle cx="-2" cy="18" r="7" fill="#FFF3C4" stroke="#E2C66B" stroke-width="1.5" />
        <circle cx="-8" cy="6" r="2.4" fill="#E8B53C" /><circle cx="6" cy="10" r="2.4" fill="#E8B53C" /><circle cx="-2" cy="18" r="2.4" fill="#E8B53C" />
      </g>
    ))}
    {pendues.map((p) => (
      <g transform={`translate(${p.x},${p.y}) rotate(${p.a}) scale(.44) translate(-50,-6)`}>
        <path d={FEUILLE} fill="#3E9A47" stroke="#245E31" stroke-width="7" />
        <path d={NERVURES} stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none" opacity=".55" />
      </g>
    ))}
  </svg>
</div>
<style>
  /* Téléphone : un grand arbre entier qui remplit l'espace entre le panneau et l'étang (il passe derrière le panneau).
     Grand écran : l'arbre entier, grand, à gauche. Le tronc prolonge celui de la couronne (même largeur : 8,4 % de la couronne). */
  .arbre { position: absolute; inset: 0; pointer-events: none; --l: 104vw; --g: -6vw; --h: calc(100% - 104vw * 0.76 - 104px); }
  .arbre__couronne { position: absolute; left: var(--g); top: var(--h); width: var(--l); height: auto; }
  .arbre__tronc { position: absolute; overflow: visible; left: calc(var(--g) + var(--l) * 0.598); width: calc(var(--l) * 0.084); top: calc(var(--h) + var(--l) * 0.76 - 1px); height: calc(100% - var(--h) - var(--l) * 0.76 - 40px); }
  @media (min-width: 900px) {
    .arbre { --l: 50vw; --g: 1vw; --h: 0vw; }
  }
</style>
