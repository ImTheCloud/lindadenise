---
import { t, chemin, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).mascotte;
const donnees = JSON.stringify({ accueil: m.accueil, anecdotes: m.anecdotes, parler: m.parler, reveiller: m.reveiller, dodo: m.dodo });
---
<aside class="mascotte" data-donnees={donnees} aria-label={m.nom}>
  <svg class="mascotte__scene" aria-hidden="true"></svg>
  <div class="mascotte__bulle" role="status" aria-live="polite" hidden>
    <p class="mascotte__texte"><span class="mascotte__cache"></span><span class="mascotte__vu" aria-hidden="true"></span></p>
    <a class="mascotte__jouer" href={chemin('jeu', lang)}>{m.jouer}</a>
    <button class="mascotte__muet" type="button" aria-label={m.fermer}>×</button>
    <button class="mascotte__silence" type="button" aria-label={m.silence} title={m.silence}>
      <svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h9l-9 11h9" stroke-width="2.6" /><path d="M13 5h7l-7 8h7" stroke-width="2.2" /><path d="M20 1.5h5l-5 5.5h5" stroke-width="1.9" /></g></svg>
    </button>
  </div>
  <p class="mascotte__invite" aria-hidden="true">{m.invite}</p>
  <!-- Zone à toucher : un bouton invisible posé sur le chat, qui le suit (doigt, souris et clavier) -->
  <button class="mascotte__corps" type="button" aria-label={m.parler}></button>
</aside>
<!-- Exécuté avant l'affichage : un chat mis en silence apparaît sans invitation ni bouton de silence -->
<script is:inline>
  try {
    if (localStorage.getItem('mascotte-muet') === '1') document.currentScript.previousElementSibling.classList.add('silence');
  } catch (e) { /* sans stockage */ }
</script>

<script>
  import { Chat, type Reperes } from './tilleul/chat';
  import { lireDecor } from './tilleul/decor';
  import { lien } from './tilleul/lien';

  const racine = document.querySelector<HTMLElement>('.mascotte');
  if (racine) {
    const scene = racine.querySelector<SVGSVGElement>('.mascotte__scene')!;
    const bulle = racine.querySelector<HTMLElement>('.mascotte__bulle')!;
    const cache = racine.querySelector<HTMLElement>('.mascotte__cache')!;
    const vu = racine.querySelector<HTMLElement>('.mascotte__vu')!;
    const invite = racine.querySelector<HTMLElement>('.mascotte__invite')!;
    const corps = racine.querySelector<HTMLButtonElement>('.mascotte__corps')!;
    const fermer = racine.querySelector<HTMLButtonElement>('.mascotte__muet')!;
    const silence = racine.querySelector<HTMLButtonElement>('.mascotte__silence')!;
    const { accueil, anecdotes, parler, reveiller: libelleReveil, dodo } = JSON.parse(racine.dataset.donnees ?? '{}') as {
      accueil: string;
      anecdotes: string[];
      parler: string;
      reveiller: string;
      dodo: string;
    };

    const lire = (cle: string) => { try { return sessionStorage.getItem(cle); } catch { return null; } };
    const ecrire = (cle: string, v: string) => { try { sessionStorage.setItem(cle, v); } catch { /* sans stockage */ } };
    // Le silence demandé par le visiteur est gardé d'une visite à l'autre
    const lireDurable = (cle: string) => { try { return localStorage.getItem(cle); } catch { return null; } };
    const ecrireDurable = (cle: string, v: string) => { try { localStorage.setItem(cle, v); } catch { /* sans stockage */ } };
    const moinsDeMouvement = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let muet = lireDurable('mascotte-muet') === '1';
    let touche = lire('mascotte-touche') === '1';
    let rang = 0;
    let minuteurBulle: number | undefined;
    let frappe: number | undefined;
    let ecrit = false;
    let repere: Reperes | undefined;

    racine.classList.toggle('touche', touche);
    racine.classList.toggle('jeu', !!document.querySelector('[data-jeu]'));

    // Sur l'accueil, la bande du chat se pose au bord de l'étang : elle colle au bas de l'écran puis monte avec la page,
    // sans calcul à chaque image (le navigateur s'en charge en défilant)
    const decor = lireDecor();
    if (decor.rail) { decor.rail.append(racine); racine.classList.add('sur-rail'); }

    // Silence : Tilleul dort, ne dit plus rien tant qu'on ne le touche pas
    const regler = () => {
      racine.classList.toggle('silence', muet);
      corps.setAttribute('aria-label', muet ? libelleReveil : parler);
    };
    regler();

    // Tailles de la bulle et de l'invitation, relevées seulement quand elles changent (la bulle est placée dès qu'elle est
    // mesurée : le chat immobile, en mouvement réduit, ne redemande pas sa place)
    const taille = new Map<Element, { l: number; h: number }>();
    const mesure = new ResizeObserver((entrees) => {
      entrees.forEach((e) => {
        const el = e.target as HTMLElement;
        taille.set(el, { l: el.offsetWidth, h: el.offsetHeight });
      });
      placer();
    });
    mesure.observe(bulle);
    mesure.observe(invite);
    let largeur = document.documentElement.clientWidth;
    addEventListener('resize', () => { largeur = document.documentElement.clientWidth; });

    // La zone à toucher, la bulle et l'invitation suivent le chat (positions dans sa bande, écritures seulement)
    let zone = { l: 0, h: 0 }, queueBulle = -1;
    const px = (n: number) => `${Math.round(n * 10) / 10}px`;
    const placer = () => {
      if (!repere) return;
      const { s, tete, boite, haut } = repere;
      // zone à toucher : le corps et la tête, jamais moins de 44 px de côté ; sa taille ne change que si l'écart est net
      const l = Math.max(44, boite.l), h = Math.max(44, boite.h);
      if (Math.abs(l - zone.l) > 8 || Math.abs(h - zone.h) > 8) {
        zone = { l, h };
        corps.style.width = px(l);
        corps.style.height = px(h);
      }
      corps.style.transform = `translate(${px(boite.x + boite.l / 2 - zone.l / 2)}, ${px(boite.y + boite.h - zone.h)})`;
      if (!bulle.hidden) {
        const t = taille.get(bulle);
        if (!t) return;
        const gauche = Math.min(Math.max(8, tete.x - t.l + 60), largeur - t.l - 8);
        const queue = Math.round(Math.min(Math.max(tete.x - gauche, 26), t.l - 40));
        bulle.style.transform = `translate(${px(gauche)}, ${px(Math.max(8 - haut, tete.y - 68 * s - t.h))})`;
        if (queue !== queueBulle) {
          queueBulle = queue;
          bulle.style.setProperty('--queue', `${queue}px`);
        }
        bulle.classList.toggle('queue-gauche', queue < t.l / 2);
      } else if (!racine.classList.contains('touche') && !racine.classList.contains('silence')) {
        const t = taille.get(invite);
        if (!t) return;
        invite.style.transform = `translate(${px(Math.min(Math.max(4, tete.x - t.l / 2), largeur - t.l - 4))}, ${px(Math.max(4 - haut, tete.y - 62 * s - t.h))})`;
      }
    };

    const chat = new Chat(scene, {
      decor,
      libre: !!document.querySelector('[data-jeu]'),
      reduit: moinsDeMouvement,
      dort: muet,
      toucher: () => toucher(),
      suit: (r) => { repere = lien.reperes = r; placer(); },
    });
    lien.chat = chat;
    // Bande hors de l'écran (accueil défilé) : le chat ne travaille plus
    new IntersectionObserver(([e]) => chat.veille(!e.isIntersecting)).observe(racine);

    // Il parle : la bulle s'écrit lettre après lettre, et sa bouche bouge tant que le texte s'écrit
    const cacherBulle = () => { bulle.hidden = true; chat.retenu = false; };
    const dire = (message: string, lecture = 6500, adieu = false) => {
      if (!message) return;
      if (!adieu && (muet || chat.dort)) return;
      window.clearInterval(frappe);
      window.clearTimeout(minuteurBulle);
      ecrit = false;
      cache.textContent = message;
      vu.textContent = '';
      bulle.hidden = false;
      chat.retenu = true;
      placer();
      bulle.classList.remove('pop');
      void bulle.offsetWidth;
      bulle.classList.add('pop');
      const terminer = () => {
        ecrit = false;
        chat.parle = false;
        minuteurBulle = window.setTimeout(cacherBulle, lecture);
      };
      if (moinsDeMouvement) { vu.textContent = message; terminer(); return; }
      chat.parle = true;
      ecrit = true;
      let i = 0;
      frappe = window.setInterval(() => {
        i += 1;
        vu.textContent = message.slice(0, i);
        if (i >= message.length) { window.clearInterval(frappe); terminer(); }
      }, 34);
    };
    // Il se tait pour de bon : plus de bulle, plus de bouche qui bouge
    const taire = () => {
      window.clearInterval(frappe);
      window.clearTimeout(minuteurBulle);
      ecrit = false;
      chat.parle = false;
      cacherBulle();
    };

    // Touché (au doigt, à la souris ou au clavier) : le chat a déjà réagi (saut, cœurs, réveil) ; ici la parole et le silence
    const toucher = () => {
      if (muet) {
        muet = false;
        ecrireDurable('mascotte-muet', '0');
        regler();
      }
      touche = true;
      ecrire('mascotte-touche', '1');
      racine.classList.add('touche');
      window.setTimeout(() => dire(anecdotes[rang++ % anecdotes.length], 5000), 450);
    };
    // La zone à toucher ne change jamais d'élément : un appui bref (sans glisser) est une caresse ; le clavier passe par « click »
    let appui: { id: number; x: number; y: number } | null = null;
    corps.addEventListener('pointerdown', (e) => { appui = { id: e.pointerId, x: e.clientX, y: e.clientY }; });
    corps.addEventListener('pointercancel', () => { appui = null; });
    corps.addEventListener('pointerup', (e) => {
      const a = appui;
      appui = null;
      if (a && a.id === e.pointerId && Math.hypot(e.clientX - a.x, e.clientY - a.y) < 12) chat.caresse();
    });
    corps.addEventListener('click', (e) => { if (e.detail === 0) chat.caresse(); });

    fermer.addEventListener('click', taire);

    silence.addEventListener('click', () => {
      muet = true;
      ecrireDurable('mascotte-muet', '1');
      taire();
      regler();
      chat.dormir();
      dire(dodo, 4500, true);
    });

    bulle.addEventListener('mouseenter', () => window.clearTimeout(minuteurBulle));
    bulle.addEventListener('mouseleave', () => {
      if (!bulle.hidden && !ecrit) minuteurBulle = window.setTimeout(cacherBulle, 3500);
    });

    // Il ne parle qu'à la toute première visite, puis seulement quand on le touche
    if (lireDurable('mascotte-accueil') !== '1') {
      window.setTimeout(() => {
        ecrireDurable('mascotte-accueil', '1');
        chat.salue();
        dire(accueil);
      }, 450);
    }

    // Il s'efface (glisse sous le bord de l'écran) quand on écrit dans un formulaire, ou quand le menu du téléphone est ouvert
    const burger = document.querySelector('[data-burger]');
    const effacer = () => {
      const ecrit = !!document.activeElement?.matches('input, textarea, select');
      racine.classList.toggle('efface', ecrit || burger?.getAttribute('aria-expanded') === 'true');
    };
    document.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea, select')) taire();
      effacer();
    });
    document.addEventListener('focusout', () => window.setTimeout(effacer));
    if (burger) new MutationObserver(effacer).observe(burger, { attributes: true, attributeFilter: ['aria-expanded'] });

    // Une barre fixe en bas de l'écran (sélection de la page Toiles) : s'il est au-dessus d'elle, il monte s'asseoir dessus
    const barre = document.querySelector<HTMLElement>('[data-tilleul-appui]');
    if (barre) new ResizeObserver(() => {
      const r = barre.getBoundingClientRect();
      const dessus = !barre.hidden && r.height > 0 && !!repere && r.left < repere.boite.x + repere.boite.l && r.right > repere.boite.x;
      decor.leve = dessus ? Math.round(innerHeight - r.top - 6) : 0;
      racine.style.setProperty('--leve', `${decor.leve}px`);
    }).observe(barre);
  }
</script>

<style is:global>
  /* La bande où vit le chat couvre le bas de l'écran mais ne reçoit aucun clic : seule la zone posée sur le chat réagit.
     Sur l'accueil, elle est posée dans le rail du bord de l'étang ([data-tilleul-rail]) : collée au bas de l'écran, puis
     elle monte avec l'étang quand on défile (sans « overflow: clip », elle reste au bord de l'étang). */
  .mascotte { position: fixed; left: 0; bottom: 0; width: 100%; height: 280px; z-index: 60; pointer-events: none; }
  .mascotte.sur-rail { position: sticky; flex: none; }
  .mascotte { translate: 0 calc(var(--leve, 0px) * -1); transition: translate 0.45s ease, visibility 0s; }
  .mascotte.efface { translate: 0 110%; visibility: hidden; transition: translate 0.45s ease, visibility 0s 0.45s; }
  @media (prefers-reduced-motion: reduce) { .mascotte, .mascotte.efface { transition: none; } }
  [data-tilleul-rail] { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; pointer-events: none; }
  .mascotte__scene { position: absolute; left: 0; bottom: 0; width: 100%; height: 280px; overflow: hidden; pointer-events: none; }
  /* Zone à toucher (et bouton du clavier) : un seul élément, qui suit le chat ; le doigt peut toujours faire défiler la page */
  .mascotte__corps { position: absolute; left: 0; top: 0; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 40%; background: none; pointer-events: auto; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; -webkit-touch-callout: none; user-select: none; }
  .mascotte__corps:focus-visible { outline-offset: 2px; }

  .mascotte__bulle { position: absolute; left: 0; top: 0; pointer-events: auto; width: max-content; max-width: min(300px, calc(100vw - 32px)); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 22px 12px 20px 12px / 12px 20px 12px 22px; padding: 12px 44px 28px 16px; font-size: 1.02rem; line-height: 1.35; box-shadow: 0 5px 0 rgba(43, 110, 58, 0.15); transform-origin: 85% 100%; }
  .mascotte__bulle[hidden] { display: none; }
  .mascotte__bulle::after { content: ''; position: absolute; left: calc(var(--queue, 60px) - 9px); bottom: -14px; width: 18px; height: 18px; background: #fff; border-right: var(--trait) solid var(--vert-fonce); border-bottom: var(--trait) solid var(--vert-fonce); transform: rotate(45deg) skew(8deg, 8deg); }
  .mascotte__bulle.pop { animation: mascotte-pop 0.45s cubic-bezier(0.3, 1.5, 0.5, 1); }
  .mascotte__texte { position: relative; margin: 0; color: var(--encre); }
  .mascotte__cache { opacity: 0; }
  .mascotte__vu { position: absolute; inset: 0; }
  /* Chemin vers la page de jeu, dans la bulle : discret sur la page de jeu elle-même (inutile) */
  .mascotte__jouer { display: inline-block; margin-top: 10px; padding: 6px 14px; font-family: var(--titre); font-size: 1.05rem; line-height: 1.1; color: #fff; background: var(--orange-fonce); border-radius: 18px 10px 16px 10px / 10px 16px 10px 18px; text-decoration: none; box-shadow: 0 3px 0 rgba(0, 0, 0, 0.18); }
  .mascotte__jouer:hover, .mascotte__jouer:focus-visible { background: var(--vert-fonce); }
  .mascotte.jeu .mascotte__jouer, .mascotte.silence .mascotte__jouer { display: none; }
  .mascotte__muet { position: absolute; top: 0; right: 0; width: 44px; height: 44px; border: 0; background: none; font-size: 1.6rem; line-height: 1; color: var(--vert-fonce); cursor: pointer; border-radius: 50%; }
  /* Pastille collée au bas de la bulle, du côté opposé à la queue (sinon elle cache la pointe) : trois Z dessinés qui montent, comme ceux du chat endormi */
  .mascotte__silence { position: absolute; left: 14px; bottom: -22px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: var(--orange-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 55% 45% 52% 48% / 48% 54% 46% 52%; box-shadow: 0 3px 0 rgba(43, 110, 58, 0.15); cursor: pointer; transition: transform 0.2s cubic-bezier(0.3, 1.5, 0.5, 1), background 0.15s; }
  .mascotte__bulle.queue-gauche .mascotte__silence { left: auto; right: 14px; }
  .mascotte__silence:hover, .mascotte__silence:focus-visible { background: var(--orange-creme); transform: rotate(-8deg) scale(1.08); }
  .mascotte.silence .mascotte__invite { display: none; }
  .mascotte.silence .mascotte__silence { display: none; }
  .mascotte__muet:hover { background: var(--orange-creme); color: var(--orange-fonce); }

  /* Invitation à toucher le chat, au-dessus de sa tête, tant qu'on ne l'a pas fait */
  .mascotte__invite { position: absolute; left: 0; top: 0; margin: 0; padding: 6px 14px; font-family: var(--titre); font-size: 1.15rem; line-height: 1.1; white-space: nowrap; color: #fff; background: var(--vert-fonce); border-radius: 18px 10px 16px 10px / 10px 16px 10px 18px; animation: mascotte-invite 1.6s ease-in-out infinite; pointer-events: none; }
  .mascotte__invite::after { content: ''; position: absolute; left: 50%; top: 100%; margin-left: -7px; border: 7px solid transparent; border-top-color: var(--vert-fonce); }
  .mascotte.touche .mascotte__invite { display: none; }
  .mascotte__bulle:not([hidden]) ~ .mascotte__invite { display: none; }

  @keyframes mascotte-pop { from { scale: 0.6; rotate: -3deg; opacity: 0; } to { scale: 1; rotate: 0deg; opacity: 1; } }
  @keyframes mascotte-invite { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }

  @media (max-width: 700px) {
    .mascotte__bulle { font-size: 0.98rem; max-width: min(240px, calc(100vw - 20px)); }
    .mascotte__invite { font-size: 1rem; padding: 5px 11px; }
  }
</style>
