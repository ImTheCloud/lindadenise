---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).mascotte;
const donnees = JSON.stringify({ accueil: m.accueil, anecdotes: m.anecdotes, parler: m.parler, reveiller: m.reveiller, dodo: m.dodo });
---
<aside class="mascotte" data-donnees={donnees} aria-label={m.nom}>
  <svg class="mascotte__scene" aria-hidden="true"></svg>
  <div class="mascotte__bulle" role="status" aria-live="polite" hidden>
    <p class="mascotte__texte"><span class="mascotte__cache"></span><span class="mascotte__vu" aria-hidden="true"></span></p>
    <button class="mascotte__muet" type="button" aria-label={m.fermer}>×</button>
    <button class="mascotte__silence" type="button" aria-label={m.silence} title={m.silence}>
      <svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h9l-9 11h9" stroke-width="2.6" /><path d="M13 5h7l-7 8h7" stroke-width="2.2" /><path d="M20 1.5h5l-5 5.5h5" stroke-width="1.9" /></g></svg>
    </button>
  </div>
  <p class="mascotte__invite" aria-hidden="true">{m.invite}</p>
  <!-- Pour le clavier : un bouton invisible posé sur le chat (la souris et le doigt touchent le dessin lui-même) -->
  <button class="mascotte__corps" type="button" aria-label={m.parler}></button>
</aside>
<!-- Exécuté avant l'affichage : un chat mis en silence apparaît sans invitation ni bouton de silence -->
<script is:inline>
  try {
    if (localStorage.getItem('mascotte-muet') === '1') document.currentScript.previousElementSibling.classList.add('silence');
  } catch (e) { /* sans stockage */ }
</script>

<script>
  import { Chat, type Reperes } from './tilleul/chat';
  import { decorAccueil } from './tilleul/decor';

  const racine = document.querySelector<HTMLElement>('.mascotte');
  if (racine) {
    const scene = racine.querySelector<SVGSVGElement>('.mascotte__scene')!;
    const bulle = racine.querySelector<HTMLElement>('.mascotte__bulle')!;
    const cache = racine.querySelector<HTMLElement>('.mascotte__cache')!;
    const vu = racine.querySelector<HTMLElement>('.mascotte__vu')!;
    const invite = racine.querySelector<HTMLElement>('.mascotte__invite')!;
    const corps = racine.querySelector<HTMLButtonElement>('.mascotte__corps')!;
    const fermer = racine.querySelector<HTMLButtonElement>('.mascotte__muet')!;
    const silence = racine.querySelector<HTMLButtonElement>('.mascotte__silence')!;
    const { accueil, anecdotes, parler, reveiller: libelleReveil, dodo } = JSON.parse(racine.dataset.donnees ?? '{}') as {
      accueil: string;
      anecdotes: string[];
      parler: string;
      reveiller: string;
      dodo: string;
    };

    const lire = (cle: string) => { try { return sessionStorage.getItem(cle); } catch { return null; } };
    const ecrire = (cle: string, v: string) => { try { sessionStorage.setItem(cle, v); } catch { /* sans stockage */ } };
    // Le silence demandé par le visiteur est gardé d'une visite à l'autre
    const lireDurable = (cle: string) => { try { return localStorage.getItem(cle); } catch { return null; } };
    const ecrireDurable = (cle: string, v: string) => { try { localStorage.setItem(cle, v); } catch { /* sans stockage */ } };
    const moinsDeMouvement = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let muet = lireDurable('mascotte-muet') === '1';
    let touche = lire('mascotte-touche') === '1';
    let rang = 0;
    let minuteurBulle: number | undefined;
    let frappe: number | undefined;
    let ecrit = false;
    let repere: Reperes | undefined;

    racine.classList.toggle('touche', touche);

    // Silence : Tilleul dort, ne dit plus rien tant qu'on ne le touche pas
    const regler = () => {
      racine.classList.toggle('silence', muet);
      corps.setAttribute('aria-label', muet ? libelleReveil : parler);
    };
    regler();

    // La bulle et l'invitation suivent sa tête, le bouton du clavier suit son corps
    const placer = () => {
      if (!repere) return;
      const { x, sol, s, tete } = repere;
      corps.style.width = `${130 * s}px`;
      corps.style.height = `${110 * s}px`;
      corps.style.transform = `translate(${x - 65 * s}px, ${sol - 110 * s}px)`;
      if (!bulle.hidden) {
        const l = bulle.offsetWidth, h = bulle.offsetHeight;
        const gauche = Math.min(Math.max(8, tete.x - l + 60), innerWidth - l - 8);
        const queue = Math.min(Math.max(tete.x - gauche, 26), l - 40);
        bulle.style.left = `${gauche}px`;
        bulle.style.top = `${Math.max(8, tete.y - 68 * s - h)}px`;
        bulle.style.setProperty('--queue', `${queue}px`);
        bulle.classList.toggle('queue-gauche', queue < l / 2);
      } else if (!racine.classList.contains('touche') && !racine.classList.contains('silence')) {
        const l = invite.offsetWidth;
        invite.style.left = `${Math.min(Math.max(4, tete.x - l / 2), innerWidth - l - 4)}px`;
        invite.style.top = `${Math.max(4, tete.y - 62 * s - invite.offsetHeight)}px`;
      }
    };

    const chat = new Chat(scene, {
      decor: decorAccueil,
      libre: !!document.querySelector('[data-jeu]'),
      reduit: moinsDeMouvement,
      dort: muet,
      toucher: () => toucher(),
      suit: (r) => { repere = r; placer(); },
    });

    // Il parle : la bulle s'écrit lettre après lettre, et sa bouche bouge tant que le texte s'écrit
    const cacherBulle = () => { bulle.hidden = true; chat.retenu = false; };
    const dire = (message: string, lecture = 6500, adieu = false) => {
      if (!message) return;
      if (!adieu && (muet || chat.dort)) return;
      window.clearInterval(frappe);
      window.clearTimeout(minuteurBulle);
      ecrit = false;
      cache.textContent = message;
      vu.textContent = '';
      bulle.hidden = false;
      chat.retenu = true;
      placer();
      bulle.classList.remove('pop');
      void bulle.offsetWidth;
      bulle.classList.add('pop');
      const terminer = () => {
        ecrit = false;
        chat.parle = false;
        minuteurBulle = window.setTimeout(cacherBulle, lecture);
      };
      if (moinsDeMouvement) { vu.textContent = message; terminer(); return; }
      chat.parle = true;
      ecrit = true;
      let i = 0;
      frappe = window.setInterval(() => {
        i += 1;
        vu.textContent = message.slice(0, i);
        if (i >= message.length) { window.clearInterval(frappe); terminer(); }
      }, 34);
    };
    // Il se tait pour de bon : plus de bulle, plus de bouche qui bouge
    const taire = () => {
      window.clearInterval(frappe);
      window.clearTimeout(minuteurBulle);
      ecrit = false;
      chat.parle = false;
      cacherBulle();
    };

    // Touché (au doigt, à la souris ou au clavier) : le chat a déjà réagi (saut, cœurs, réveil) ; ici la parole et le silence
    const toucher = () => {
      if (muet) {
        muet = false;
        ecrireDurable('mascotte-muet', '0');
        regler();
      }
      touche = true;
      ecrire('mascotte-touche', '1');
      racine.classList.add('touche');
      window.setTimeout(() => dire(anecdotes[rang++ % anecdotes.length], 5000), 450);
    };
    corps.addEventListener('click', () => chat.caresse());
    // La page de jeu donne ses ordres par cet événement
    addEventListener('tilleul-ordre', (e) => chat.ordre((e as CustomEvent).detail));

    fermer.addEventListener('click', taire);

    silence.addEventListener('click', () => {
      muet = true;
      ecrireDurable('mascotte-muet', '1');
      taire();
      regler();
      chat.dormir();
      dire(dodo, 4500, true);
    });

    bulle.addEventListener('mouseenter', () => window.clearTimeout(minuteurBulle));
    bulle.addEventListener('mouseleave', () => {
      if (!bulle.hidden && !ecrit) minuteurBulle = window.setTimeout(cacherBulle, 3500);
    });

    // Il ne parle qu'à la toute première visite, puis seulement quand on le touche
    if (lireDurable('mascotte-accueil') !== '1') {
      window.setTimeout(() => {
        ecrireDurable('mascotte-accueil', '1');
        chat.salue();
        dire(accueil);
      }, 450);
    }

    document.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea, select')) taire();
    });
  }
</script>

<style is:global>
  /* La bande où vit le chat couvre le bas de l'écran mais ne reçoit aucun clic : seul le dessin du chat réagit */
  .mascotte { position: fixed; left: 0; bottom: 0; width: 100%; height: 0; z-index: 60; pointer-events: none; }
  .mascotte__scene { position: fixed; left: 0; bottom: 0; width: 100%; overflow: hidden; pointer-events: none; }
  .mascotte .t-chat { pointer-events: visiblePainted; cursor: pointer; }
  .mascotte__corps { position: fixed; left: 0; top: 0; padding: 0; border: 0; border-radius: 24px; background: none; pointer-events: none; }
  .mascotte__corps:focus-visible { outline-offset: 2px; }

  .mascotte__bulle { position: fixed; left: 8px; top: 8px; pointer-events: auto; width: max-content; max-width: min(300px, calc(100vw - 32px)); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 22px 12px 20px 12px / 12px 20px 12px 22px; padding: 12px 44px 28px 16px; font-size: 1.02rem; line-height: 1.35; box-shadow: 0 5px 0 rgba(43, 110, 58, 0.15); transform-origin: 85% 100%; }
  .mascotte__bulle[hidden] { display: none; }
  .mascotte__bulle::after { content: ''; position: absolute; left: calc(var(--queue, 60px) - 9px); bottom: -14px; width: 18px; height: 18px; background: #fff; border-right: var(--trait) solid var(--vert-fonce); border-bottom: var(--trait) solid var(--vert-fonce); transform: rotate(45deg) skew(8deg, 8deg); }
  .mascotte__bulle.pop { animation: mascotte-pop 0.45s cubic-bezier(0.3, 1.5, 0.5, 1); }
  .mascotte__texte { position: relative; margin: 0; color: var(--encre); }
  .mascotte__cache { opacity: 0; }
  .mascotte__vu { position: absolute; inset: 0; }
  .mascotte__muet { position: absolute; top: 0; right: 0; width: 44px; height: 44px; border: 0; background: none; font-size: 1.6rem; line-height: 1; color: var(--vert-fonce); cursor: pointer; border-radius: 50%; }
  /* Pastille collée au bas de la bulle, du côté opposé à la queue (sinon elle cache la pointe) : trois Z dessinés qui montent, comme ceux du chat endormi */
  .mascotte__silence { position: absolute; left: 14px; bottom: -22px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: var(--orange-fonce); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 55% 45% 52% 48% / 48% 54% 46% 52%; box-shadow: 0 3px 0 rgba(43, 110, 58, 0.15); cursor: pointer; transition: transform 0.2s cubic-bezier(0.3, 1.5, 0.5, 1), background 0.15s; }
  .mascotte__bulle.queue-gauche .mascotte__silence { left: auto; right: 14px; }
  .mascotte__silence:hover, .mascotte__silence:focus-visible { background: var(--orange-creme); transform: rotate(-8deg) scale(1.08); }
  .mascotte.silence .mascotte__invite { display: none; }
  .mascotte.silence .mascotte__silence { display: none; }
  .mascotte__muet:hover { background: var(--orange-creme); color: var(--orange-fonce); }

  /* Invitation à toucher le chat, au-dessus de sa tête, tant qu'on ne l'a pas fait */
  .mascotte__invite { position: fixed; left: 0; top: 0; margin: 0; padding: 6px 14px; font-family: var(--titre); font-size: 1.15rem; line-height: 1.1; white-space: nowrap; color: #fff; background: var(--vert-fonce); border-radius: 18px 10px 16px 10px / 10px 16px 10px 18px; animation: mascotte-invite 1.6s ease-in-out infinite; pointer-events: none; }
  .mascotte__invite::after { content: ''; position: absolute; left: 50%; top: 100%; margin-left: -7px; border: 7px solid transparent; border-top-color: var(--vert-fonce); }
  .mascotte.touche .mascotte__invite { display: none; }
  .mascotte__bulle:not([hidden]) ~ .mascotte__invite { display: none; }

  @keyframes mascotte-pop { from { transform: scale(0.6) rotate(-3deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes mascotte-invite { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

  @media (max-width: 700px) {
    .mascotte__bulle { font-size: 0.98rem; max-width: min(240px, calc(100vw - 20px)); }
    .mascotte__invite { font-size: 1rem; padding: 5px 11px; }
  }
</style>
