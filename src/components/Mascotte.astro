---
import svg from './mascotte.svg?raw';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const m = t(lang).mascotte;
const donnees = JSON.stringify({ sections: m.sections, anecdotes: m.anecdotes, reveil: m.reveil });
---
<aside class="mascotte" data-etat="repos" data-donnees={donnees} aria-label={m.nom}>
  <div class="mascotte__bulle" role="status" aria-live="polite" hidden>
    <p class="mascotte__texte"></p>
    <button class="mascotte__muet" type="button" aria-label={m.fermer}>×</button>
  </div>
  <p class="mascotte__invite" aria-hidden="true">{m.invite}</p>
  <div class="mascotte__coeurs" aria-hidden="true"></div>
  <button class="mascotte__corps" type="button" aria-label={m.parler}>
    <Fragment set:html={svg} />
  </button>
</aside>

<script>
  const racine = document.querySelector<HTMLElement>('.mascotte');
  if (racine) {
    const bulle = racine.querySelector<HTMLElement>('.mascotte__bulle')!;
    const texte = racine.querySelector<HTMLElement>('.mascotte__texte')!;
    const corps = racine.querySelector<HTMLButtonElement>('.mascotte__corps')!;
    const fermer = racine.querySelector<HTMLButtonElement>('.mascotte__muet')!;
    const coeurs = racine.querySelector<HTMLElement>('.mascotte__coeurs')!;
    const { sections, anecdotes, reveil } = JSON.parse(racine.dataset.donnees ?? '{}') as {
      sections: Record<string, string>;
      anecdotes: string[];
      reveil: string;
    };

    const lire = (cle: string) => { try { return sessionStorage.getItem(cle); } catch { return null; } };
    const ecrire = (cle: string, v: string) => { try { sessionStorage.setItem(cle, v); } catch { /* sans stockage */ } };
    const moinsDeMouvement = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let muet = lire('mascotte-muet') === '1';
    let touche = lire('mascotte-touche') === '1';
    let dernierSujet = '';
    let dernierChangement = 0;
    let rang = 0;
    let minuteurBulle: number | undefined;
    let minuteurEtat: number | undefined;
    let minuteurSommeil: number | undefined;

    racine.classList.toggle('touche', touche);

    const etat = (e: string, duree = 0) => {
      racine.dataset.etat = e;
      window.clearTimeout(minuteurEtat);
      if (duree) minuteurEtat = window.setTimeout(() => { if (racine.dataset.etat === e) racine.dataset.etat = 'repos'; }, duree);
    };

    const dire = (message: string, duree = 9000) => {
      if (muet || !message || racine.dataset.etat === 'dort' || racine.dataset.etat === 'couche') return;
      texte.textContent = message;
      bulle.hidden = false;
      bulle.classList.remove('pop');
      void bulle.offsetWidth;
      bulle.classList.add('pop');
      if (racine.dataset.etat === 'repos') etat('parle', Math.min(duree - 500, 600 + message.length * 55));
      window.clearTimeout(minuteurBulle);
      minuteurBulle = window.setTimeout(() => (bulle.hidden = true), duree);
      dernierChangement = Date.now();
    };

    const faireDesCoeurs = (n: number) => {
      if (moinsDeMouvement) return;
      for (let i = 0; i < n; i++) {
        const c = document.createElement('span');
        c.textContent = '♥';
        c.className = 'mascotte__coeur';
        c.style.setProperty('--dx', `${Math.round((Math.random() - 0.5) * 90)}px`);
        c.style.setProperty('--delai', `${i * 120}ms`);
        c.style.color = i % 3 === 0 ? '#3e9a47' : '#f28a1e';
        coeurs.appendChild(c);
        window.setTimeout(() => c.remove(), 1900 + i * 120);
      }
    };

    // Repos : sans activité le chat se couche, puis s'endort ; le moindre mouvement le relève
    let minuteurDodo: number | undefined;
    const reveiller = () => {
      window.clearTimeout(minuteurSommeil);
      window.clearTimeout(minuteurDodo);
      const avant = racine.dataset.etat;
      if (avant === 'dort' || avant === 'couche') {
        etat('repos');
        racine.classList.add('etire');
        window.setTimeout(() => racine.classList.remove('etire'), 1500);
        if (avant === 'dort') window.setTimeout(() => dire(reveil, 5000), 600);
      }
      minuteurSommeil = window.setTimeout(() => { bulle.hidden = true; etat('couche'); }, 18000);
      minuteurDodo = window.setTimeout(() => { bulle.hidden = true; etat('dort'); }, 40000);
    };
    ['pointermove', 'scroll', 'keydown', 'touchstart'].forEach((nom) => addEventListener(nom, reveiller, { passive: true }));
    reveiller();

    // Le regard suit le pointeur (ordinateur)
    if (matchMedia('(pointer: fine)').matches && !moinsDeMouvement) {
      let attente = false;
      addEventListener('pointermove', (e) => {
        if (attente) return;
        attente = true;
        requestAnimationFrame(() => {
          const r = corps.getBoundingClientRect();
          const dx = (e.clientX - (r.left + r.width / 2)) / (innerWidth / 2);
          const dy = (e.clientY - (r.top + r.height * 0.35)) / (innerHeight / 2);
          racine.style.setProperty('--rx', String(Math.max(-1, Math.min(1, dx)).toFixed(2)));
          racine.style.setProperty('--ry', String(Math.max(-1, Math.min(1, dy)).toFixed(2)));
          attente = false;
        });
      }, { passive: true });
    }

    // Petites habitudes de chat, de temps en temps
    const habitudes = ['etire', 'oreille', 'regarde-g', 'regarde-d', 'toilette'];
    const habitude = () => {
      if (racine.dataset.etat === 'repos' && !moinsDeMouvement) {
        const h = habitudes[Math.floor(Math.random() * habitudes.length)];
        racine.classList.add(h);
        window.setTimeout(() => racine.classList.remove(h), h === 'toilette' ? 2300 : 1700);
      }
      window.setTimeout(habitude, 8000 + Math.random() * 8000);
    };
    window.setTimeout(habitude, 6000);

    fermer.addEventListener('click', () => {
      muet = true;
      ecrire('mascotte-muet', '1');
      bulle.hidden = true;
      etat('repos');
    });

    corps.addEventListener('click', () => {
      if (muet) { muet = false; ecrire('mascotte-muet', '0'); }
      touche = true;
      ecrire('mascotte-touche', '1');
      racine.classList.add('touche');
      reveiller();
      etat('saute', 900);
      faireDesCoeurs(6);
      window.setTimeout(() => dire(anecdotes[rang++ % anecdotes.length], 8000), 450);
    });
    racine.addEventListener('mouseenter', () => window.clearTimeout(minuteurBulle));
    racine.addEventListener('mouseleave', () => {
      if (!bulle.hidden) minuteurBulle = window.setTimeout(() => (bulle.hidden = true), 3500);
    });

    // Arrivée : le chat salue une fois par visite
    const depart = document.body.dataset.mascotteDepart ?? 'texte';
    const dejaVu = lire('mascotte-vu') === '1';
    dernierSujet = depart;
    if (!dejaVu) {
      window.setTimeout(() => {
        etat('salut', 3200);
        ecrire('mascotte-vu', '1');
        dire(sections[depart]);
      }, 1000);
    }
    document.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches('input, textarea, select')) bulle.hidden = true;
    });

    // Il commente la section visible et fait un petit saut en changeant de sujet
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (!e.isIntersecting) continue;
            const cle = (e.target as HTMLElement).dataset.mascotte ?? '';
            if (!cle || cle === dernierSujet || !sections[cle]) continue;
            if (Date.now() - dernierChangement < 4000) continue;
            dernierSujet = cle;
            if (racine.dataset.etat === 'repos') etat('saute', 700);
            window.setTimeout(() => dire(sections[cle]), 350);
          }
        },
        { threshold: 0.55 },
      );
      document.querySelectorAll('[data-mascotte]').forEach((el) => obs.observe(el));
    }
  }
</script>

<style is:global>
  .mascotte { position: fixed; right: clamp(8px, 2vw, 28px); bottom: 0; z-index: 60; width: clamp(112px, 13vw, 210px); pointer-events: none; }
  .mascotte > * { pointer-events: auto; }
  .mascotte__corps { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; filter: drop-shadow(0 6px 8px rgba(43, 110, 58, 0.2)); transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1); transform-origin: 50% 100%; }
  .mascotte__corps:hover, .mascotte__corps:focus-visible { transform: scale(1.06) rotate(-1.5deg); }
  .mascotte__corps:active { transform: scale(0.97); }
  .mascotte__corps:focus-visible { outline-offset: 2px; }
  .mascotte-svg { width: 100%; height: auto; overflow: visible; display: block; }

  .mascotte__bulle { position: absolute; right: 8%; bottom: calc(100% - 6px); width: max-content; max-width: min(300px, calc(100vw - 32px)); background: #fff; border: var(--trait) solid var(--vert-fonce); border-radius: 22px 12px 20px 12px / 12px 20px 12px 22px; padding: 12px 44px 12px 16px; font-size: 1.02rem; line-height: 1.35; box-shadow: 0 5px 0 rgba(43, 110, 58, 0.15); transform-origin: 85% 100%; }
  .mascotte__bulle[hidden] { display: none; }
  .mascotte__bulle::after { content: ''; position: absolute; right: 30px; bottom: -14px; width: 18px; height: 18px; background: #fff; border-right: var(--trait) solid var(--vert-fonce); border-bottom: var(--trait) solid var(--vert-fonce); transform: rotate(45deg) skew(8deg, 8deg); }
  .mascotte__bulle.pop { animation: mascotte-pop 0.45s cubic-bezier(0.3, 1.5, 0.5, 1); }
  .mascotte__texte { margin: 0; color: var(--encre); }
  .mascotte__muet { position: absolute; top: 0; right: 0; width: 44px; height: 44px; border: 0; background: none; font-size: 1.6rem; line-height: 1; color: var(--vert-fonce); cursor: pointer; border-radius: 50%; }
  .mascotte__muet:hover { background: var(--orange-creme); color: var(--orange-fonce); }

  /* Invitation à toucher le chat, tant qu'on ne l'a pas fait */
  .mascotte__invite { position: absolute; right: 100%; bottom: 14%; margin: 0 6px 0 0; padding: 6px 14px; font-family: var(--titre); font-size: 1.15rem; line-height: 1.1; white-space: nowrap; color: #fff; background: var(--vert-fonce); border-radius: 18px 10px 16px 10px / 10px 16px 10px 18px; animation: mascotte-invite 1.6s ease-in-out infinite; pointer-events: none; }
  .mascotte__invite::after { content: ''; position: absolute; left: 100%; top: 50%; margin-top: -7px; border: 7px solid transparent; border-left-color: var(--vert-fonce); }
  .mascotte.touche .mascotte__invite { display: none; }

  .mascotte__coeurs { position: absolute; left: 50%; top: 30%; width: 0; height: 0; pointer-events: none; }
  .mascotte__coeur { position: absolute; font-size: 1.5rem; line-height: 1; opacity: 0; animation: mascotte-coeur 1.8s ease-out forwards; animation-delay: var(--delai, 0ms); }

  /* Le regard suit le pointeur */
  .m-regard { transform: translate(calc(var(--rx, 0) * 5px), calc(var(--ry, 0) * 4px)); transition: transform 0.18s ease-out; }

  /* Parties animées, pivots en unités du dessin (viewBox 360 x 360) ; seules les paupières utilisent leur propre boîte */
  .m-queue { transform-origin: 206px 318px; animation: m-queue 4.6s ease-in-out infinite; }
  .m-tete { transform-origin: 150px 206px; animation: m-tete 6s ease-in-out infinite; }
  .m-corps { transform-origin: 150px 350px; animation: m-respire 3.6s ease-in-out infinite; }
  .m-paupiere { transform-box: fill-box; transform-origin: 50% 0%; transform: scaleY(0); animation: m-cligne 5.2s infinite; }
  .m-bras-mouvement { transform-origin: 118px 254px; }
  .m-pose-corps, .m-pose-tete, .m-pose-queue { transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1); }
  .m-pose-corps { transform-origin: 150px 352px; }
  .m-pose-tete { transform-origin: 150px 206px; }
  .m-pose-queue { transform-origin: 206px 318px; }
  .m-oreille-g { transform-origin: 112px 90px; }
  .m-oreille-d { transform-origin: 188px 90px; }
  .m-zzz { opacity: 0; }
  .mascotte__corps:hover .m-oreille-g { animation: m-oreille-g 0.5s ease-in-out 2; }
  .mascotte__corps:hover .m-oreille-d { animation: m-oreille-d 0.5s ease-in-out 2 0.1s; }
  .mascotte-svg .m-bouche-ouverte { display: none !important; }

  .mascotte[data-etat='parle'] .m-bouche-fermee { display: none; }
  .mascotte[data-etat='parle'] .m-bouche-ouverte { display: block !important; transform-origin: 150px 168px; animation: m-parle 0.34s ease-in-out infinite; }
  .mascotte[data-etat='parle'] .m-tete { animation: m-hoche 0.7s ease-in-out infinite; }

  .mascotte[data-etat='salut'] .m-bras-salut, .mascotte.toilette .m-bras-salut { display: block !important; }
  .mascotte[data-etat='salut'] .m-bras-mouvement { animation: m-salue 0.5s ease-in-out infinite alternate; }
  .mascotte.toilette .m-bras-mouvement { transform: rotate(38deg); animation: m-toilette 0.45s ease-in-out infinite alternate; }
  .mascotte.toilette .m-tete { animation: m-toilette-tete 2.2s ease-in-out; }
  .mascotte[data-etat='salut'] .m-bouche-fermee { display: none; }
  .mascotte[data-etat='salut'] .m-bouche-ouverte { display: block !important; }

  .mascotte[data-etat='saute'] .mascotte__corps { animation: m-saute 0.8s cubic-bezier(0.3, 0.7, 0.4, 1); }
  .mascotte[data-etat='saute'] .m-bouche-fermee { display: none; }
  .mascotte[data-etat='saute'] .m-bouche-ouverte { display: block !important; }

  /* Couché : le corps s'aplatit, la tête se pose, les yeux se mi-ferment. Endormi : yeux clos et zZz. */
  .mascotte[data-etat='couche'] .m-pose-corps, .mascotte[data-etat='dort'] .m-pose-corps { transform: scale(1.14, 0.74); }
  .mascotte[data-etat='couche'] .m-pose-tete, .mascotte[data-etat='dort'] .m-pose-tete { transform: translate(6px, 54px) rotate(5deg); }
  .mascotte[data-etat='couche'] .m-pose-queue, .mascotte[data-etat='dort'] .m-pose-queue { transform: rotate(16deg) translate(-6px, 4px); }
  .mascotte[data-etat='couche'] .m-paupiere { transform: scaleY(0.5); animation: none; }
  .mascotte[data-etat='couche'] .m-regard, .mascotte[data-etat='dort'] .m-regard { transform: none; }
  .mascotte[data-etat='dort'] .m-yeux { display: none; }
  .mascotte[data-etat='dort'] .m-yeux-clos { display: block !important; }
  .mascotte[data-etat='dort'] .m-tete { animation: m-dort-tete 5s ease-in-out infinite; }
  .mascotte[data-etat='dort'] .m-corps { animation-duration: 6s; }
  .mascotte[data-etat='dort'] .m-queue, .mascotte[data-etat='couche'] .m-queue { animation-duration: 9s; }
  .mascotte[data-etat='dort'] .m-zzz { opacity: 1; }
  .mascotte[data-etat='dort'] .m-z { animation: m-zzz 2.8s ease-in-out infinite; }
  .mascotte[data-etat='dort'] .m-z2 { animation-delay: 0.6s; }
  .mascotte[data-etat='dort'] .m-z3 { animation-delay: 1.2s; }

  .mascotte.etire .m-corps { animation: m-etire 1.5s ease-in-out; }
  .mascotte.etire .m-tete { animation: m-etire-tete 1.5s ease-in-out; }
  .mascotte.regarde-g .m-tete { animation: m-regarde-g 1.7s ease-in-out; }
  .mascotte.regarde-d .m-tete { animation: m-regarde-d 1.7s ease-in-out; }
  .mascotte.oreille .m-oreille-g { animation: m-oreille-g 0.45s ease-in-out 3; }
  .mascotte.oreille .m-oreille-d { animation: m-oreille-d 0.45s ease-in-out 3 0.15s; }

  @keyframes mascotte-pop { from { transform: scale(0.6) rotate(-3deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes mascotte-invite { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-7px); } }
  @keyframes mascotte-coeur { 0% { transform: translate(0, 0) scale(0.5); opacity: 0; } 15% { opacity: 1; } 100% { transform: translate(var(--dx, 0), -120px) scale(1.2); opacity: 0; } }
  @keyframes m-queue { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(5deg); } }
  @keyframes m-tete { 0%, 100% { transform: rotate(-1.5deg); } 50% { transform: rotate(2deg); } }
  @keyframes m-hoche { 0%, 100% { transform: rotate(-3deg) translateY(0); } 50% { transform: rotate(3deg) translateY(2px); } }
  @keyframes m-respire { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.016); } }
  @keyframes m-cligne { 0%, 92%, 100% { transform: scaleY(0); } 95% { transform: scaleY(1); } }
  @keyframes m-parle { 0%, 100% { transform: scaleY(0.45); } 50% { transform: scaleY(1); } }
  @keyframes m-salue { from { transform: rotate(-12deg); } to { transform: rotate(16deg); } }
  @keyframes m-toilette { from { transform: rotate(34deg); } to { transform: rotate(44deg); } }
  @keyframes m-toilette-tete { 0%, 100% { transform: rotate(0); } 20%, 80% { transform: rotate(-6deg) translate(-4px, 8px); } }
  @keyframes m-saute { 0% { transform: translateY(0) scale(1, 1); } 15% { transform: translateY(0) scale(1.06, 0.92); } 45% { transform: translateY(-38px) scale(0.96, 1.07); } 80% { transform: translateY(0) scale(1.05, 0.94); } 100% { transform: none; } }
  @keyframes m-dort-tete { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }
  @keyframes m-zzz { 0% { transform: translate(0, 10px); opacity: 0; } 30% { opacity: 1; } 100% { transform: translate(8px, -14px); opacity: 0; } }
  @keyframes m-etire { 0%, 100% { transform: scale(1, 1); } 40%, 60% { transform: scale(0.97, 1.07); } }
  @keyframes m-etire-tete { 0%, 100% { transform: translateY(0); } 40%, 60% { transform: translateY(-8px) rotate(-3deg); } }
  @keyframes m-regarde-g { 0%, 100% { transform: rotate(0); } 30%, 70% { transform: rotate(-8deg) translateX(-4px); } }
  @keyframes m-regarde-d { 0%, 100% { transform: rotate(0); } 30%, 70% { transform: rotate(8deg) translateX(4px); } }
  @keyframes m-oreille-g { 50% { transform: rotate(-14deg); } }
  @keyframes m-oreille-d { 50% { transform: rotate(14deg); } }

  @media (max-width: 700px) {
    .mascotte { width: 112px; right: 4px; }
    .mascotte__bulle { right: 2px; font-size: 0.98rem; max-width: min(240px, calc(100vw - 20px)); }
    .mascotte__invite { font-size: 1rem; padding: 5px 11px; bottom: 26%; }
  }
</style>
