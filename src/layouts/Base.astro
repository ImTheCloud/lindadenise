---
import '@fontsource/gochi-hand';
import '@fontsource/itim';
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Mascotte from '../components/Mascotte.astro';
import { t, SITE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  titre?: string;
  description?: string;
  /** chemins de la page dans chaque langue, pour le sélecteur et hreflang */
  chemins: { fr: string; nl: string };
  image?: string;
  noindex?: boolean;
}
const { lang, titre, description, chemins, image = '/images/partage.png', noindex = false } = Astro.props;
const d = t(lang);
const titrePage = titre ? `${titre} – Linda Denise` : d.meta.titre;
const desc = description ?? d.meta.description;
const canonique = SITE + chemins[lang];
---
<!doctype html>
<html lang={lang} class="sans-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titrePage}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#3e9a47" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonique} />
    <link rel="alternate" hreflang="fr" href={SITE + chemins.fr} />
    <link rel="alternate" hreflang="nl" href={SITE + chemins.nl} />
    <link rel="alternate" hreflang="x-default" href={SITE + chemins.fr} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Linda Denise" />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={SITE + image} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'nl_BE'} />
    <script is:inline>document.documentElement.classList.remove('sans-js');</script>
  </head>
  <body>
    <a class="evitement" href="#principal">{lang === 'fr' ? 'Aller au contenu' : 'Naar de inhoud'}</a>
    <Entete lang={lang} chemins={chemins} />
    <main id="principal"><slot /></main>
    <PiedDePage lang={lang} />
    <Mascotte lang={lang} />
    <script>
      // Apparition douce des blocs au défilement
      const blocs = document.querySelectorAll('.apparait');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entrees) => entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }),
          { threshold: 0.12 },
        );
        blocs.forEach((b) => obs.observe(b));
      } else blocs.forEach((b) => b.classList.add('visible'));
    </script>
    <style is:global>
      .evitement { position: absolute; left: -999px; top: 0; background: #fff; padding: 8px 14px; z-index: 100; }
      .evitement:focus { left: 8px; top: 8px; }
    </style>
  </body>
</html>
