---
import '@fontsource/gochi-hand';
import '@fontsource/itim';
import '../styles/global.css';
// Polices préchargées : le texte s'affiche tout de suite dans sa police, sans décaler la page.
import policeTitre from '@fontsource/gochi-hand/files/gochi-hand-latin-400-normal.woff2?url';
import policeTexte from '@fontsource/itim/files/itim-latin-400-normal.woff2?url';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Mascotte from '../components/Mascotte.astro';
import { t, SITE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  titre?: string;
  description?: string;
  /** chemins de la page dans chaque langue, pour le sélecteur et hreflang */
  chemins: { fr: string; nl: string };
  image?: string;
  noindex?: boolean;
  /** monde du site : les dessins (vert) ou les toiles (brun) */
  monde?: 'dessins' | 'toiles';
}
const { lang, titre, description, chemins, image = '/images/partage.png', noindex = false, monde = 'dessins' } = Astro.props;
const d = t(lang);
const titrePage = titre ? `${titre} – Linda Denise` : d.meta.titre;
const desc = description ?? d.meta.description;
const canonique = SITE + chemins[lang];
---
<!doctype html>
<html lang={lang} class="sans-js" data-monde={monde}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titrePage}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content={monde === 'toiles' ? '#d9700b' : '#3e9a47'} />
    <link rel="preload" href={policeTitre} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonique} />
    <link rel="alternate" hreflang="fr" href={SITE + chemins.fr} />
    <link rel="alternate" hreflang="nl" href={SITE + chemins.nl} />
    <link rel="alternate" hreflang="x-default" href={SITE + chemins.fr} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Linda Denise" />
    <meta property="og:title" content={titrePage} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={SITE + image} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_BE' : 'nl_BE'} />
    <script is:inline>document.documentElement.classList.remove('sans-js');</script>
  </head>
  <body>
    <a class="evitement" href="#principal">{lang === 'fr' ? 'Aller au contenu' : 'Naar de inhoud'}</a>
    <Entete lang={lang} chemins={chemins} />
    <main id="principal"><slot /></main>
    <PiedDePage lang={lang} />
    <Mascotte lang={lang} />
    <script>
      import { lire, basculer, nombre, type Genre } from '../components/panier';
      // Apparition douce des blocs au défilement
      const blocs = document.querySelectorAll('.apparait');
      if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entrees) => entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }),
          { threshold: 0.12 },
        );
        blocs.forEach((b) => obs.observe(b));
      } else blocs.forEach((b) => b.classList.add('visible'));

      // Panier : tout bouton [data-panier="genre:identifiant"] ajoute ou retire l'article ; le compteur de l'en-tête suit
      const majPanier = () => {
        const p = lire();
        document.querySelectorAll<HTMLElement>('[data-panier]').forEach((b) => {
          const [genre, id] = b.dataset.panier!.split(':') as [Genre, string];
          const dedans = p[genre].includes(id);
          b.setAttribute('aria-pressed', String(dedans));
          const texte = b.querySelector('[data-panier-texte]') ?? b;
          texte.textContent = (dedans ? b.dataset.dedans : b.dataset.ajouter) ?? '';
          const titre = b.dataset.titre;
          if (titre) b.setAttribute('aria-label', ((dedans ? b.dataset.ariaDedans : b.dataset.ariaAjouter) ?? '').replace('{t}', titre));
        });
        const n = nombre(p);
        document.querySelectorAll<HTMLElement>('[data-panier-nombre]').forEach((c) => { c.textContent = String(n); c.hidden = n === 0; });
      };
      document.addEventListener('click', (e) => {
        const b = (e.target as Element).closest<HTMLElement>('[data-panier]');
        if (!b) return;
        const [genre, id] = b.dataset.panier!.split(':') as [Genre, string];
        basculer(genre, id);
      });
      window.addEventListener('panier-change', majPanier);
      majPanier();
      document.documentElement.classList.add('panier-pret');
    </script>
    <style is:global>
      .evitement { position: absolute; left: -999px; top: 0; background: #fff; padding: 8px 14px; z-index: 100; }
      .evitement:focus { left: 8px; top: 8px; }
    </style>
  </body>
</html>
